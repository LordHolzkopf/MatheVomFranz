{
  "title": "ln von e-Potenzen berechnen",
  "description": "Terme wie ln(eⁿ), ln(1/eⁿ) und ln(√(eⁿ)) vereinfachen: natürlicher Logarithmus, e-Funktion, Umkehrfunktion, ln, exp",
  "dest":["QCC"],
  "keys":["_","/","_","_","_","_","_","_"],
  "consigne": "Berechne.",
  "options": [
    {
      "name": "ln(eⁿ), n natürliche Zahl",
      "vars": {
        "n": "0_20"
      },
      "question": "\\ln(e^{${:n}})",
      "answer": ":question=\\color{red}{${:n}}",
      "value":":n"
    },
    {
      "name": "ln(1/eⁿ), n natürliche Zahl",
      "vars": {
        "n": "0_20"
      },
      "question": "\\ln\\left(\\dfrac1{e^{${:n}}}\\right)",
      "answer": ":question=\\color{red}{${:n>0?-:n:0}}",
      "value":"${:n>0?-:n:0}"
    },
    {
      "name": "ln(√(eⁿ))",
      "vars": {
        "n": "0_10"
      },
      "question": "\\ln\\left(\\sqrt e${:n!=1?'^{'+:n+'}':''}\\right)",
      "answer": ":question\\color{green}{${:n>0&&:n%2==0?'=\\dfrac{'+(:n)+'}2':''}}=\\color{red}{${MMmath.fractionSimplifiee(:n,2)}}",
      "value":"${MMmath.fractionSimplifiee(:n,2)}"
    },
    {
      "name": "ln(1/√(eⁿ))",
      "vars": {
        "n": "0_10"
      },
      "question": "\\ln\\left(\\dfrac 1{\\sqrt e${:n!=1?'^{'+:n+'}':''}}\\right)",
      "answer": ":question\\color{green}{${:n>0&&:n%2==0?'=\\dfrac{'+(-:n)+'}2':''}}=\\color{red}{${MMmath.fractionSimplifiee(-:n,2)}}",
      "value":"${MMmath.fractionSimplifiee(-:n,2)}"
    },{
      "name":"ln der n-ten Wurzel aus e (nicht im Lehrplan)",
      "vars":{
        "n":"3_10"
      },
      "question":"\\ln \\sqrt[${:n}]{e}",
      "answer":":question=\\color{red}{\\dfrac1${:n}}",
      "value":"\\dfrac1${:n}"
    }
  ]
}
