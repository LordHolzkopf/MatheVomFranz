        "question": "(${:x}${MMmath.signedNumber(:a)})(${:x}${MMmath.signedNumber(:b)})",
        "shortq": "(${:x}${MMmath.signedNumber(:a)})(${:x}${MMmath.signedNumber(:b)})",
        "answer":"(${:x}${MMmath.signedNumber(:a)})(${:x}${MMmath.signedNumber(:b)})=\\color{red}{${:x}^2${(:a+:b!=0)?MMmath.signedNumberButOne(:a+:b)+:x:''}${MMmath.signedNumber(:a*:b)}}",
        "value":"${:x}^2${(:a+:b!=0)?MMmath.signedNumberButOne(:a+:b)+:x:''}${MMmath.signedNumber(:a*:b)}"
