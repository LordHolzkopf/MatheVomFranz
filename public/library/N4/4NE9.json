        "question": "\\text{Löse } ${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${:c}",
        "shortq":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${:c}",
        "answer":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${:c} \\text{ gilt für } \\color{red}{${:x}=${MMmath.calc('('+:c+'-('+:b+'))/('+:a+')')}}",
        "value":"${MMmath.calc('('+:c+'-('+:b+'))/('+:a+')')}"
    },{
        "name":"ax + b = cx + d",
        "vars":{"a":"-10_10_^0","b":"-10_10", "c":"-10_10_^0", "d":"-10_10", "l":"0_5","x":"${:lettres[:l]}"},
        "question": "\\text{Löse } ${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${MMmath.signIfOne(:c)}${:x}${MMmath.signedNumber(:d)}",
        "shortq":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${MMmath.signIfOne(:c)}${:x}${MMmath.signedNumber(:d)}",
        "answer":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${MMmath.signIfOne(:c)}${:x}${MMmath.signedNumber(:d)} \\text{ gilt für } \\color{red}{${:a-:c==0?(:b==:d?'\\text{alle Zahlen}':'\\text{keine Zahl}')::x+'='+MMmath.calc('('+:d+'-('+:b+'))/(('+:a+')-('+:c+'))')}}",
        "value":"${:a-:c==0?(:b==:d?'alle Zahlen':'keine Lösung'):MMmath.calc('('+:d+'-('+:b+'))/(('+:a+')-('+:c+'))')}"
    }]
