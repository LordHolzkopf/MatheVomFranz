{
    "ID": "6GD5",
    "title":"Sich berührende und schneidende Kreise: Längen bestimmen",
    "description":"Kreise, die sich berühren oder schneiden, Radius, Abstand der Mittelpunkte, Streckenlänge, Berührpunkt, Schnittpunkt",
    "type":"text",
    "dest":["6DC"],
    "consts":{"lettres":"ABCDEFGHJKLMNPQRSTUVW"},
    "options":[
        {
            "name": "Kreise berühren sich",
            "vars":{
                "l":"0_${:lettres.length-1}_3_^&",
                "A":"${:lettres[:l[0]]}",
                "B":"${:lettres[:l[1]]}",
                "C":"${:lettres[:l[2]]}",
                "s":"4_8",
                "s1":"2_${:s-2}",
                "s2":"${:s-:s1}",
                "qp":", $$\\overline{${:A+:B}}=?$$",
                "ap":", $$\\overline{${:A+:B}}=\\color{red}{${MMmath.round(:s)}}$$"
           },
           "figure":{
                "type":"graph",
                "axis":false,
                "boundingbox":[0,8,17,-8],
                "content":[
                    ["point",["${:s1+0.5}",0],{"name":"${:A}", "face":"x","label":{"offset":[5,-5]}}],
                    ["point",["${:s1+:s+0.5}",0],{"name":"${:B}", "face":"x","label":{"offset":[5,-5]}}],
                    ["point",["${:s1*2+0.5}",0],{"name":"${:C}", "face":"x","label":{"offset":[5,-5]}}],
                    ["circle",["${:A}","${:s1}"], {"strokeWidth":1.3}],
                    ["circle",["${:B}","${:s2}"], {"strokeWidth":1.3}],
                    ["point",["${0.5+:s1+:s1*Math.cos(2*Math.PI/3)}","${:s1*Math.sin(2*Math.PI/3)}"],{"name":"X","face":"","label":{"visible":false}}],
                    ["point",["${0.5+:s+:s1+:s2*Math.cos(Math.PI/3)}","${:s2*Math.sin(Math.PI/3)}"],{"name":"Y","face":"","label":{"visible":false}}],
                    ["segment",["${:A}","X"],{"strokeWidth":1.3, "dash":1, "label":{}}],
                    ["segment",["${:B}","Y"],{"strokeWidth":1.3, "dash":1}],
                    ["text", ["${:s1/2}","${:s1/2}","${:s1}"]],
                    ["text", ["${:s1+:s+.5}","${:s2/2}","${:s2}"]]
                ]
           }
        },{
            "name": "Kreise schneiden sich",
            "vars":{
                "l":"0_${:lettres.length-1}_4_^&",
                "A":"${:lettres[:l[0]]}",
                "B":"${:lettres[:l[1]]}",
                "C":"${:lettres[:l[2]]}",
                "D":"${:lettres[:l[3]]}",
                "s":"4_8",
                "s1":"3_${:s-1}",
                "s2":"${:s-:s1+1}_7",
                "qp":", $$\\overline{${:D+:B}}=?$$, $$\\overline{${:A+:D}}=?$$",
                "ap":", $$\\overline{${:D+:B}}=\\color{red}{${:s2}}$$, $$\\overline{${:A+:D}}=\\color{red}{${:s1}}$$"
           },
           "figure":{
                "type":"graph",
                "axis":false,
                "boundingbox":[0,8,18,-8],
                "content":[
                    ["point",["${:s1+0.5}",0],{"name":"${:A}", "face":"x","label":{"offset":[5,-5]}}],
                    ["point",["${:s1+:s+0.5}",0],{"name":"${:B}", "face":"x","label":{"offset":[5,-5]}}],
                    ["circle",["${:A}","${:s1}"], {"name":"C1","strokeWidth":1.3}],
                    ["circle",["${:B}","${:s2}"], {"name":"C2","strokeWidth":1.3}],
                    ["intersection",["C1","C2",0],{"name":"${:C}", "face":"x","label":{"offset":[-3,-10]}}],
                    ["intersection",["C1","C2",1],{"name":"${:D}", "face":"x","label":{"offset":[-3,10]}}],
                    ["point",["${0.5+:s1+:s1*Math.cos(2*Math.PI/3)}","${:s1*Math.sin(2*Math.PI/3)}"],{"name":"X","face":"","label":{"visible":false}}],
                    ["point",["${0.5+:s+:s1+:s2*Math.cos(Math.PI/3)}","${:s2*Math.sin(Math.PI/3)}"],{"name":"Y","face":"","label":{"visible":false}}],
                    ["segment",["${:A}","X"],{"strokeWidth":1.3, "dash":1, "label":{}}],
                    ["segment",["${:B}","Y"],{"strokeWidth":1.3, "dash":1}],
                    ["text", ["${:s1/2}","${:s1/2-0.5}","${:s1}"]],
                    ["text", ["${:s1+:s+:s2/2}","${:s2/2-0.5}","${:s2}"]]
                ]
           }
        }
    ],
    "consigne":"Bestimme die Streckenlängen.",
    "question":"$$\\overline{${:A+:C}}=?$$, $$\\overline{${:B+:C}}=?$$${:qp}",
    "answer":"$$\\overline{${:A+:C}}=\\color{red}{${MMmath.round(:s1,1)}}$$, $$\\overline{${:B+:C}}=\\color{red}{${MMmath.round(:s2,1)}}$$${:ap}"
}