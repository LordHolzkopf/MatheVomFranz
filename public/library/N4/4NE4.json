        "answer":["${:a}\\times(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})=\\color{red}{${MMmath.signIfOne(:a*:b)}${:x}${MMmath.signedNumber(:a*:c)}}","${:a}\\times(${:c}${MMmath.signedNumberButOne(:b)}${:x})=\\color{red}{${:a*:c}${MMmath.signedNumberButOne(:a*:b)}${:x}}"],
        "value":"${MMmath.calc(:a+'*('+:b+:x+')+('+:a+')*('+:c+')')}"
    },{
        "name":"Zahl mal Summe",
        "vars":{"l":"0_4","x":"${:lettres[:l]}", "a":"-10_10_^0,1","b":"-10_10_^0","c":"-10_10_^0"},
        "question": ["${:a}\\times(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})","${:a}\\times(${:c}${MMmath.signedNumberButOne(:b)}${:x})"],
        "shortq":["${:a}\\times(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})","${:a}\\times(${:c}${MMmath.signedNumberButOne(:b)}${:x})"],
        "answer":["${:a}\\times(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})=\\color{red}{${MMmath.signIfOne(:a*:b)}${:x}${MMmath.signedNumber(:a*:c)}}","${:a}\\times(${:c}${MMmath.signedNumberButOne(:b)}${:x})=\\color{red}{${:a*:c}${MMmath.signedNumberButOne(:a*:b)}${:x}}"],
        "value":"${MMmath.calc(:a+'*('+:b+:x+')+('+:a+')*('+:c+')')}"
    },{
        "name":"Summe mal Summe, einfach, positive Koeffizienten",
        "vars":{"l":"0_4","x":"${:lettres[:l]}", "a":"1_10","b":"1_10"},
        "question": "(${:x}+${:a})(${:x}+${:b})",
        "shortq": "(${:x}+${:a})(${:x}+${:b})",
        "answer":"(${:x}+${:a})(${:x}+${:b})=\\color{red}{${:x}^2+${:a+:b}${:x}+${:a*:b}}",
        "value":"${:x}^2+${:a+:b}${:x}+${:a*:b}"
    },{
        "name":"Summe mal Summe, einfach, auch negative Koeffizienten",
