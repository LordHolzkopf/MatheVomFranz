{
    "ID": "5AA5",
    "title": "Variablen verwenden",
    "description":"Scratch, Programmieren, Variable setzen, Variable ändern, Wert einer Variablen, sage Text oder Variable, was sagt die Figur",
    "type":"text",
    "dest":["WGB"],
    "options":[
        {
            "name":"Variable oder ihren Wert ausgeben",
            "consts":{
                "varnames":[
                    "Birne","Apfel","Banane","a", "b", "c","Hund","Katze","Ding","Zahl"
                ]
            },"vars":{"a":"1_10", "b":"1_10", "var0":"0_9", "var":"${:varnames[:var0]}", "varoupas":"0_1"},
            "figure": {
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "setze [${:var} v] auf (${:a})",
                    "ändere [${:var} v] um (${:b})",
                    "sage ${:varoupas==0?'['+:var+']':'('+:var+')'}"
                ]
            },
            "question":"Was sagt die Figur?",
            "answer":"Die Figur sagt <span class='red'>${:varoupas==0?:var::a+:b}</span>.",
            "value":"${:varoupas==0?:var::a+:b}"
        },{
            "name":"Variable setzen und mit einer Rechnung ändern",
            "consts":{
                "varnames":[
                    "Birne","Apfel","Banane","a", "b", "c","Hund","Katze","Ding","Zahl"
                ],
                "operations":[
                    "+","-","*"
                ],
                "valeurs":[
                    "${:a+:b}", "${:a-:b}", "${:a*:b}"
                ]
            },
            "vars":{"a":"1_10", "b":"1_10", "ope0":"0_2", "var0":"0_9", "var":"${:varnames[:var0]}", "varoupas":"0_1"},
            "figure": {
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "setze [${:var} v] auf (${:a})",
                    "setze [${:var} v] auf ((${:var}) ${:operations[:ope0]} (${:b}))",
                    "sage ${:varoupas==0?'['+:var+']':'('+:var+')'}"
                ]
            },
            "question":"Was sagt die Figur?",
            "answer":"Die Figur sagt <span class='red'>${:varoupas==0?:var::valeurs[:ope0]}</span>.",
            "value":"${:varoupas==0?:var::valeurs[:ope0]}"
        },{
            "name":"Variable in einer Wiederholung ändern",
            "consts":{
                "varnames":[
                    "Birne","Apfel","Banane","a", "b", "c","Hund","Katze","Ding","Zahl"
                ]
            },
            "vars":{"a":"1_10", "r":"1_9", "b":"-10_10_^0", "ope0":"0_2", "var0":"0_9", "var":"${:varnames[:var0]}", "varoupas":"0_1"},
            "figure": {
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "setze [${:var} v] auf (${:a})",
                    "wiederhole (${:r}) mal",
                    "ändere [${:var} v] um (${:b})",
                    "Ende",
                    "sage ${:varoupas==0?'['+:var+']':'('+:var+')'}"
                ]
            },
            "question":"Was sagt die Figur?",
            "answer":"Die Figur sagt <span class='red'>${:varoupas==0?:var::a+:r*:b}</span>.",
            "value":"${:varoupas==0?:var::a+:r*:b}"
        }
    ]
}
