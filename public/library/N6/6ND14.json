    "dest":["5CD"],
    "params":{
        "soi":{"label":"Manchmal die Zahl selbst als Lösung","defaut":true}
    },
    "options":[{
        "name":"Vielfaches finden",
        "vars":{
            "a":"8_24_^prime",
            "d":"${MMmath.unDiviseur(:a,true,true)}",
            "e":"-1_1_^0",
            "nd":"${MMmath.nonDiviseur(:a)}",
            "m":"${:soi && utils.alea()<0.25 ? :a : :a*MMmath.aleaInt(2,5)}",
            "nm":"${:a*MMmath.aleaInt(2,5)+MMmath.aleaInt(1,:a-1)*:e}",
            "t":"${:d},${:nd},${:m},${:nm}"
        },
        "question": "Welche dieser Zahlen ist ein <b>Vielfaches</b> von ${:a}?<br>${utils.shuffle(:t.split(',')).join('; ')}",
        "shortq":"<b>Vielfaches</b> von ${:a}?<br>${utils.shuffle(:t.split(',')).join('; ')}",
        "answer":"<span class='red'>${:m}</span> ist ein <b>Vielfaches</b> von ${:a}.",
        "value":"${:m}"
    },{
        "name":"Teiler finden",
        "vars":{
