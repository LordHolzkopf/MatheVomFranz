{
    "title": "Dreiecksungleichung anwenden",
    "ID":"6GC5",
    "dest":["7EC", "5BA"],
    "type":"text",
    "textSize":"small",
    "description":"Dreiecksungleichung: Seitenlängen vergleichen, Existenz eines Dreiecks, Punkt auf einer Strecke, Längen addieren. Nicht für den interaktiven Modus (online/Duell) geeignet.",
    "consts":{
        "points":"ABCDEFGHIJKLMNOPRST"
    },
    "options":[
        {
            "name": "Längen vergleichen",
            "vars":{
                "l":"0_${:points.length-1}_3_^&",
                "A":"${:points[:l[0]]}",
                "B":"${:points[:l[1]]}",
                "C":"${:points[:l[2]]}",
                "eq":[true,false],
                "xA":"d-4_-2.8_1",
                "yA":"d-3_3_1",
                "xC":"d2.8_4_1",
                "yC":"d-3_3_1",
                "pente":"${(:yC-:yA)/(:xC-:xA)}",
                "intercept":"${:yA-(:pente*:xA)}",
                "xB":"d${:xA+1}_${:xC-1}_1",
                "yBf":"${:pente*:xB+:intercept}",
                "ecart":"d2_4.5_1",
                "yB":"${:eq?:yBf::yBf<0?:yBf+:ecart::yBf-:ecart}",
                "long":"d2_10_1"
            },
            "question":"Was kannst du über $$\\overline{${:A+:B}} + \\overline{${:B+:C}}$$ aussagen?",
            "answer":"$$\\overline{${:A+:B}} + \\overline{${:B+:C}} ${:eq?'=':'\\gt'} ${:long}$$ cm",
            "value":"${:A+:B} + ${:B+:C}${:eq?'=':'>'}${:long}",
            "figure": {
                "type":"graph",
                "boundingbox":[-6,6,6,-6],
                "axis":false,
                "grid":false,
                "content":[
                    ["point", ["${:xA}", "${:yA}"], {"name":"${:A}", "size":3, "face":"x", "label":{"offset":[-15,0]}}],
                    ["point", ["${:xC}", "${:yC}"], {"name":"${:C}", "size":3,"face":"x", "label":{"offset":[10,0]}}],
                    ["segment", ["${:A}", "${:C}"]],
                    ["point", ["${:xB}", "${:yB}"], {"name":"${:B}", "size":3, "face":"x", "label":{"offset":[5,"${:pente<0?10:-10}"]}}],
                    ["text", ["${(:xA+:xC)/2-1.5}", "${(:yA+:yC)/2+(:eq?(:pente<0?-1.5:1.5)::yB<Math.min(:yA,:yC)?1.5:-1.5)}", "${String(:long).replace('.',',')} cm"]]
                ]
            }
        },{
            "name": "Die drei Dreiecksungleichungen aufschreiben",
            "vars":{
                "l":"0_${:points.length-1}_3_^&",
                "A":"${:points[:l[0]]}",
                "B":"${:points[:l[1]]}",
                "C":"${:points[:l[2]]}",
                "xA":"d-4_-2.8_1",
                "yA":"d-4_4_1",
                "xC":"d2.8_4_1",
                "yC":"d-4_4_1",
                "pente":"${(:yC-:yA)/(:xC-:xA)}",
                "intercept":"${:yA-(:pente*:xA)}",
                "xB":"d-2_-0.5_1",
                "yBf":"${:pente*:xB+:intercept}",
                "ecart":"d2_4.5_1",
                "yB":"${:yBf<0?:yBf+:ecart::yBf-:ecart}"
            },
            "question":"Schreibe die drei Dreiecksungleichungen für das Dreieck ${:A+:B+:C} auf.",
            "answer":"$$\\overline{${:A+:C}} \\lt \\overline{${:A+:B}} + \\overline{${:B+:C}}$$<br>$$\\overline{${:C+:B}} \\lt \\overline{${:C+:A}} + \\overline{${:A+:B}}$$<br>$$\\overline{${:B+:A}} \\lt \\overline{${:B+:C}} + \\overline{${:C+:A}}$$",
            "figure": {
                "type":"graph",
                "boundingbox":[-6,6,6,-6],
                "axis":false,
                "grid":false,
                "content":[
                    ["point", ["${:xA}", "${:yA}"], {"name":"${:A}", "size":3, "face":"x", "label":{"offset":[-15,0]}}],
                    ["point", ["${:xC}", "${:yC}"], {"name":"${:C}", "size":3,"face":"x", "label":{"offset":[10,0]}}],
                    ["point", ["${:xB}", "${:yB}"], {"name":"${:B}", "size":3, "face":"x", "label":{"offset":[0,"${:yB>Math.min(:yA,:yC)?10:-10}"]}}],
                    ["polygon", ["${:A}", "${:C}", "${:B}"]]
                ]
            }
        },{
            "name":"Prüfen, ob es das Dreieck gibt",
            "vars":{
                "l1":"1_10",
                "l2":"1_10",
                "exists":[true, false],
                "l3":"${:exists?(Math.abs(:l1-:l2)+1)+'_'+(:l1+:l2-1):(:l1+:l2+1)+'_21'}",
                "tri":"0_2_3_^&",
                "max":"${Math.max(:l1,:l2,:l3)}",
                "min":"${Math.min(:l1,:l2,:l3)}",
                "third":"${MMmath.valeursIntermediaires([:l1,:l2,:l3])[0]}"
            },
            "consts":{
                "longueurs":[":l1", ":l2", ":l3"]
            },
            "question":"Gibt es ein Dreieck mit den Seitenlängen ${:longueurs[:tri[0]]} cm, ${:longueurs[:tri[1]]} cm und ${:longueurs[:tri[2]]} cm?",
            "answer":"${:exists?'Ja, denn $$'+:min+' + '+:third+' \\gt '+:max+'$$.':'Nein, denn $$'+:l1+' + '+:l2+' \\lt '+:l3+'$$.'}",
            "value":["${:exists?'\\text{ja}':'\\text{nein}'}", "${:exists?'ja':'nein'}"],
            "keys":["o","n"]
        },{
            "name":"Gleichung für Streckenlängen aufstellen",
            "vars":{
                "l":"0_${:points.length-1}_3_^&",
                "A":"${:points[:l[0]]}",
                "B":"${:points[:l[1]]}",
                "C":"${:points[:l[2]]}"
            },
            "question":[
                "Stelle eine Gleichung für Streckenlängen auf, wenn der Punkt $$${:B}$$ auf der Strecke $$\\overline{${:A+:C}}$$ liegt.",
                "Stelle eine Gleichung für Streckenlängen auf, wenn die Punkte ${:A}, ${:B} und ${:C} in dieser Reihenfolge auf einer Geraden liegen."
            ],
            "answer":"$$${:B}$$ liegt auf $$\\overline{${:A+:C}}$$, also gilt $$\\color{red}{\\overline{${:A+:B}} + \\overline{${:B+:C}} = \\overline{${:A+:C}}}$$."
        },{
            "name": "Punkt auf einer Strecke erkennen",
            "vars": {
                "l1":"1_10",
                "l2":"1_10",
                "l3":"${:l1+:l2}",
                "l":"0_${:points.length-1}_3_^&",
                "A":"${:points[:l[0]]}",
                "B":"${:points[:l[1]]}",
                "C":"${:points[:l[2]]}",
                "tri":"0_2_3_^&",
                "cx":"0_1_3"
            },
            "consts":{
                "egalites":[["\\overline{${:A+:B}}=${:l1}","\\overline{${:B+:A}}=${:l1}"], ["\\overline{${:C+:B}}=${:l2}","\\overline{${:B+:C}}=${:l2}"],["\\overline{${:A+:C}}=${:l3}","\\overline{${:C+:A}}=${:l3}"]]
            },
            "question":"Was kannst du über drei Punkte ${:A}, ${:B} und ${:C} aussagen, für die $$${:egalites[:tri[0]][:cx[0]]}$$, $$${:egalites[:tri[1]][:cx[1]]}$$ und $$${:egalites[:tri[2]][:cx[2]]}$$ gilt?",
            "answer":"${:A}, ${:B} und ${:C} liegen in dieser Reihenfolge auf einer Geraden, d. h. $$\\color{red}{${:B} \\in \\overline{${:A+:C}}}$$."
        }
    ]
}
