{
    "title":"Prozentrechnung ergänzen",
    "description":"Prozentwert, Prozentsatz oder Grundwert berechnen, Prozentrechnung, Prozent von, Anteil, Bruchschreibweise p/100, Hundertstel",
    "ID":"4DC3",
    "dest":["7CA", "5FD", "6AD"],
    "vars":{
        "p":[1,5,10,20,25,30,40,50,75,100],
        "b":"1_25",
        "n":"${:b*20}",
        "r":"${Math.round(:p*:n/100)}"
    },
    "options":[{
        "name":"Prozentwert berechnen (gängige Prozentsätze)",
        "question":"${:p}\\%\\text{ von }${:n} = \\, ?",
        "answer":"\\dfrac{${:p}}{100}\\times${:n}=\\color{red}{${:r}}",
        "value":"${:r}"
    },{
        "name":"Prozentsatz berechnen",
        "question":"?\\,\\%\\text{ von }${:n} = ${:r}",
        "answer":":question\\\\\\dfrac{${:r}\\times100}{${:n}}=\\color{red}{${:p}}",
        "value":"${:p}"
    },{
        "name":"Grundwert berechnen",
        "question":"${:p}\\%\\text{ von }\\, ? = ${:r}",
        "answer":":question\\\\\\dfrac{${:r}\\times100}{${:p}}=\\color{red}{${:n}}",
        "value":"${:n}"
    },{
        "name":"Bruchschreibweise: Prozentsatz berechnen",
        "question":"${:r} = \\dfrac{?}{100}\\times${:n}",
        "answer":":question\\\\${:r}=\\dfrac{${:p}}{100}\\times${:n}\\text{, also }?=\\color{red}{${:p}}",
        "value":"${:p}"
    },{
        "name":"Bruchschreibweise: Grundwert berechnen",
        "question":"${:r} = \\dfrac{${:p}}{100}\\times \\, ?",
        "answer":"${:r}=\\dfrac{${:p}}{100}\\times${:n}\\\\\\text{also }?=\\color{red}{${:n}}",
        "value":"${:n}"
    }]
}
