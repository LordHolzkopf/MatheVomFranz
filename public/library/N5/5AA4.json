{
    "ID":"5AA4",
    "title":"Zeichenbefehle verstehen",
    "type":"text",
    "description":"Scratch, Programmieren, Malstift, Vieleck zeichnen, regelmäßiges Vieleck erkennen, Dreieck, Quadrat, Fünfeck, Sechseck, Achteck, Drehwinkel, Außenwinkel",
    "dest":["WGB"],
    "repeat":3,
    "options":[{
        "name":"Vieleck mit bis zu 6 Seiten erkennen",
        "consts":{
            "figures":["Dreieck", "Quadrat", "Fünfeck", "Sechseck"],
            "angles":[120, 90, 72, 60]
        },
        "vars":{"x":"3_6","d0":"1_10", "d":"${:d0*10}", "sens":["turnright", "turnleft"]},
        "figure":{
            "type":"scratch",
            "content":[
                "Wenn @greenFlag angeklickt wird",
                "schalte Stift ein",
                "wiederhole (${:x}) mal",
                "gehe (${:d}) er Schritt",
                "drehe dich @${:sens} um (${:angles[:x-3]}) Grad",
                "Ende"
            ]
        },
        "question":"Welche Figur wird gezeichnet?",
        "answer":"Es wird ein <span class='red'>${:figures[:x-3]}</span> gezeichnet.",
        "value":"${:figures[:x-3]}"
    },{
        "name":"Vieleck erkennen, mit zu vielen oder zu wenigen Wiederholungen",
        "consts":{
            "figures":["Dreieck", "Quadrat", "Fünfeck", "Sechseck"],
            "angles":[120, 90, 72, 60]
        },
        "vars":{"x":"3_6","d0":"1_10", "d":"${:d0*10}", "sens":["turnright", "turnleft"], "trop":"-3_4_^0"},
        "figure":{
            "type":"scratch",
            "content":[
                "Wenn @greenFlag angeklickt wird",
                "schalte Stift ein",
                "wiederhole (${:x+:trop}) mal",
                "gehe (${:d}) er Schritt",
                "drehe dich @${:sens} um (${:angles[:x-3]}) Grad",
                "Ende"
            ]
        },
        "question":"Welche Figur wird gezeichnet?",
        "answer":"${:trop>0?'Es wird ein <span class=\"red\">'+:figures[:x-3]+'</span> gezeichnet.':(:x+:trop)==0?'Es wird nur <span class=\"red\">ein Punkt</span> gezeichnet.':(:x+:trop)==1?'Es wird <span class=\"red\">eine Strecke</span> gezeichnet.':'Es wird <span class=\"red\">ein Streckenzug</span> gezeichnet.'}",
        "value":"${:trop>0?:figures[:x-3]:(:x+:trop)==0?'Punkt':(:x+:trop)==1?'Strecke':'Streckenzug'}"
    },{
        "name":"Vieleck mit 8, 9, 10 oder 12 Seiten erkennen",
        "consts":{
            "figures":["Achteck", "Neuneck", "Zehneck", "Zwölfeck"],
            "cotes":[8, 9, 10, 12],
            "angles":[45, 40, 36, 30]
        },
        "vars":{"x":"0_3","d0":"1_10", "d":"${:d0*10}", "sens":["turnright", "turnleft"]},
        "figure":{
            "type":"scratch",
            "content":[
                "Wenn @greenFlag angeklickt wird",
                "schalte Stift ein",
                "wiederhole (${:cotes[:x]}) mal",
                "gehe (${:d}) er Schritt",
                "drehe dich @${:sens} um (${:angles[:x]}) Grad",
                "Ende"
            ]
        },
        "question":"Welche Figur wird gezeichnet?",
        "answer":"Es wird ein <span class='red'>${:figures[:x]}</span> gezeichnet.",
        "value":"${:figures[:x]}"
    }]
}
