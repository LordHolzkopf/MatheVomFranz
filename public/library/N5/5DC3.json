    },{
        "name":"Durch Subtrahieren von Spalten",
        "vars":{"a1":"2_40","a2":"2_40_^${:a1}","a3":"${Math.abs(:a1-:a2)}","coeff":"d0.1_2.9_1_^1,2","choix":"1_3","b1":"${MMmath.round(:a1*:coeff,1)}","b2":"${MMmath.round(:a2*:coeff,1)}","b3":"${MMmath.round(:a3*:coeff,1)}"}
    },{
        "name":"Mit dem Proportionalitätsfaktor",
        "vars":{"a1":"1_10","a2":"1_10_^${:a1}","a3":"1_12_^${:a1},${:a2}","coeff":"2_12", "b1":"${:a1*:coeff}", "b2":"${:a2*:coeff}", "b3":"${:a3*:coeff}","choix":"1_3"}
    },{
        "name":"Durch Vervielfachen einer Spalte",
        "vars":{"s":"1_6","a1":"2_10_^${2*:s},${3*:s},${4*:s}","c1":"0_4","a2":"${:a1*:prime[:c1]}","c2":"2_12_^${:c1}","a3":"${:c2*:a1}","b1":"${:a1+:s}","b2":"${:b1*:prime[:c1]}","b3":"${:c2*:b1}","choix":"1_3"}
    },{
        "name":"Mit dem Dreisatz (einfach)",
        "vars":{"a2":"11_20","b1":"2_15_^prime","a3":"2_12_^prime","a1":[2,5,10,"${MMmath.plusGrandDiviseur(:b1*:a3)}"],"b2":"${MMmath.round(:a2*:b1/:a1,2)}", "b3":"${MMmath.round(:a3*:b1/:a1,2)}","choix":"1_3"}
    }
    ],
    "question": "<table class='inline-table'><tr><td>${:choix==1?:a3::a1}</td><td>${:choix==2?:a3::choix==1?:a1::a2}</td><td>${:choix==3?:a3::a2}</td></tr><tr><td>${:choix==1?'?'::b1}</td><td>${:choix==2?'?'::choix==1?:b1::b2}</td><td>${:choix==3?'?'::b2}</td></tr></table>",
    "answer":"<table class='inline-table'><tr><td>${:choix==1?:a3::a1}</td><td>${:choix==2?:a3::choix==1?:a1::a2}</td><td>${:choix==3?:a3::a2}</td></tr><tr><td>${:choix==1?'$$\\color{red}{'+:b3+'}$$'::b1}</td><td>${:choix==2?'$$\\color{red}{'+:b3+'}$$'::choix==1?:b1::b2}</td><td>${:choix==3?'$$\\color{red}{'+:b3+'}$$'::b2}</td></tr></table>",
    "value":"${:b3}"
