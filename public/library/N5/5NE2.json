{
    "title":"Produkte mit Variablen vereinfachen",
    "description":"Produkt vereinfachen, Malpunkt weglassen, Zahl mal Variable, Terme vereinfachen, Variablen, Termumformung",
    "type":"latex",
    "ID":"5NE2",
    "dest":["7DB"],
    "consts":{"lettres":["a","b","c","x","y","z"]},
    "valueType":"expressionSimplifiee",
    "consigne":"Vereinfache.",
    "keys":["-","x²","a","b","c","x","y","z"],
    "options":[{
        "name":"Zahl mal Variable",
        "vars":{"l":"1_5","a":"1_9","x":"${:lettres[:l]}"},
        "question": ["${:a}\\times ${:x}", "${:x}\\times${:a}"],
        "answer":":question=\\color{red}{${MMmath.calc(:a+'*'+:x)}}",
        "value":"${MMmath.calc(:a+'*'+:x)}"
    },{
        "name":"Variable mal Variable",
        "vars":{"l":"0_5_2","x":"${:lettres[:l[0]]}","y":"${:lettres[:l[1]]}"},
        "question": "${:x}\\times ${:y}",
        "answer":":question=\\color{red}{${MMmath.calc(:x+'*'+:y)}}",
        "value":"${MMmath.calc(:x+'*'+:y)}"
    },{
        "name":"Zwei Zahlen und eine Variable",
        "vars":{"l":"0_5","a":"1_9","b":"1_9","x":"${:lettres[:l]}"},
        "question": ["${:a}\\times${:b}\\times ${:x}","${:a}\\times ${:x}\\times ${:b}","${:x}\\times${:a}\\times${:b}"],
        "answer":":question=\\color{red}{${MMmath.calc(:a+'*'+:b+'*'+:x)}}",
        "value":"${MMmath.calc(:a+'*'+:b+'*'+:x)}"
    },{
        "name":"Eine Zahl und zwei Variablen",
        "vars":{"l":"0_5_2","a":"1_9","x":"${:lettres[:l[0]]}","y":"${:lettres[:l[1]]}"},
        "question": ["${:a}\\times ${:y}\\times ${:x}","${:x}\\times${:a}\\times ${:y}","${:x}\\times ${:y}\\times${:a}"],
        "answer":":question=\\color{red}{${MMmath.calc(:a+'*'+:x+'*'+:y)}}",
        "value":"${MMmath.calc(:a+'*'+:x+'*'+:y)}"
    },{
        "name":"Zwei Zahlen (auch negativ) und eine Variable",
        "vars":{"l":"0_5","a":"-9_9_^0","b":"-9_9_^0","x":"${:lettres[:l]}"},
        "question": ["${:a}\\times${(:b<0)?'('+:b+')'::b}\\times ${:x}","${:a}\\times ${:x}\\times ${(:b<0)?'('+:b+')'::b}","${:x}\\times${(:a<0)?'('+:a+')'::a}\\times${(:b<0)?'('+:b+')'::b}"],
        "answer":":question=\\color{red}{${MMmath.calc(:a+'*('+:b+')*'+:x)}}",
        "value":"${MMmath.calc(:a+'*('+:b+')*'+:x)}"
    },{
        "name":"Eine Zahl (auch negativ) und zwei Variablen",
        "vars":{"l":"0_5_2","a":"-9_9_^0","x":"${:lettres[:l[0]]}","y":"${:lettres[:l[1]]}"},
        "question": ["${:a}\\times ${:y}\\times ${:x}","${:x}\\times ${(:a<0)?'('+:a+')'::a}\\times ${:y}","${:x}\\times ${:y}\\times${(:a<0)?'('+:a+')'::a}"],
        "answer":":question=\\color{red}{${MMmath.calc(:a+'*'+:x+'*'+:y)}}",
        "value":"${MMmath.calc(:a+'*'+:x+'*'+:y)}"
    }
    ]
}
