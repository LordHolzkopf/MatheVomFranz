        "answer":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=0 \\text{ gilt für } \\color{red}{${:x}=${MMmath.calc('-('+:b+')/('+:a+')')}}",
        "value":"${MMmath.calc('-('+:b+')/('+:a+')')}"
