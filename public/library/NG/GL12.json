{
    "dest":["WEB"],
    "title":"Das n-te Glied einer Folge berechnen",
    "description":"Folge, n-tes Glied, Folgenglied berechnen, rekursive Darstellung, explizite Darstellung, Bildungsvorschrift, arithmetische Folge, geometrische Folge",
    "type":"text",
    "options":[
        {
            "name":"Arithmetische Folgen, rekursiv gegeben",
            "vars":{
                "u1":"-10_10",
                "r":"-10_10_^0",
                "n":"2_8"
            },
            "consts":{
                "quest":"Gegeben ist die Folge mit $$a_1=${:u1}$$ und $$a_n=a_{n-1}${MMmath.signedNumber(:r)}$$.<br>"
            },
            "answer":"$$a_{${:n}}=${:u1}+(${:n}-1)\\times${MMmath.nP(:r)}=\\color{red}{${:u1+(:n-1)*:r}}$$",
            "value":"${:u1+(:n-1)*:r}"
        },{
            "name":"Arithmetische Folgen, explizit gegeben (lineare Bildungsvorschrift)",
            "consts":{
                "quest":"Gegeben ist die Folge mit $$a_n=${:u0}${:u0!=0?MMmath.signedNumberButOne(:k):MMmath.signIfOne(:k)}${:b!=0?'(':''}n${MMmath.signedNumber(:b)}${:b!=0?')':''}$$.<br>"
            },
            "vars":{
                "u0":"-10_10",
                "k":"-10_10_^0,1",
                "b":"-10_10",
                "n":"3_9"
            },
            "answer":"$$a_{${:n}}=${:u0}${:u0!=0?MMmath.signedNumberButOne(:k):MMmath.signIfOne(:k)}${:b!=0?'(':''}${:n}${MMmath.signedNumber(:b)}${:b!=0?')':''}=\\color{red}{${:u0+:k*(:n+:b)}}$$",
            "value":"${:u0+:k*(:n+:b)}"
        },{
            "name":"Konstante Folge",
            "consts":{
                "quest":"Gegeben ist die Folge mit $$a_n=${:n}$$.<br>"
            },
            "vars":{
                "n":"2_20"
            },
            "answer":"$$a_{${:n}}=\\color{red}{${:n}}$$",
            "value":":n"
        },{
            "name":"Geometrische Folgen mit dem Quotienten 2",
            "consts":{
                "quest":"Gegeben ist die Folge mit $$a_n=${:u0}\\times2^{n${MMmath.signedNumber(:b)}}$$.<br>"
            },
            "vars":{
                "u0":[-3,-1,1,3],
                "b":"-2_2_^0",
                "n":"2_8"
            },
            "answer":"$$a_{${:n}}=${:u0}\\times2^{${:n}${MMmath.signedNumber(:b)}}=\\color{red}{${:u0*(2**(:n+:b))}}$$",
            "value":"${:u0*(2**(:n+:b))}"
        },{
            "name":"Geometrische Folgen mit dem Quotienten 1/2 oder 1/3",
            "consts":{
                "quest":"Gegeben ist die Folge mit $$a_n=${:u0}\\times\\left(\\dfrac 1${:r}\\right)^{n${MMmath.signedNumber(:b)}}$$.<br>"
            },
            "vars":{
                "r":[2,3],
                "n0":"1_4",
                "n":"2_${:r==3?:n0+3:8}",
                "u0":"${:r**:n0}",
                "b":"-2_2"
            },
            "answer":"$$a_{${:n}}=${:u0}\\times\\left(\\dfrac 1${:r}\\right)^{${:n}${MMmath.signedNumber(:b)}}=\\color{red}{${MMmath.calc(:u0+'/'+:r**(:n+:b))}}$$",
            "value":"${MMmath.calc(:u0+'/'+:r**(:n+:b))}"
        }
    ],
    "question":[
        "${:quest}Berechne $$a_{${:n}}$$.",
        "${:quest}Wie lautet das ${:n}. Glied der Folge?"
    ]
}
