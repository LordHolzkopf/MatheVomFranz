{
    "title":"Die Einerziffer bestimmen",
    "description":"Stellenwerte: Ziffer an der Einerstelle bei natürlichen Zahlen und Dezimalzahlen bestimmen, Einer, Stellenwerttafel",
    "keys":"numerique",
    "ID":"8NC1",
    "dest":["5AA", "6BA"],
    "type":"text",
    "options":[
        {
            "name":"Natürliche Zahlen < 1000",
            "vars":{
                "u":"0_9",
                "ns":"1_9_2_^&,0,${:u}",
                "nb":"${:ns[0]*100+:ns[1]*10+:u}"
            }
        },
        {
            "name":"Natürliche Zahlen < 1 000 000",
            "vars":{
                "u":"0_9",
                "ns":"0_9_5_^&,${:u}",
                "nb":"${:ns[0]*100000+:ns[1]*10000+:ns[2]*1000+:ns[3]*100+:ns[4]*10+:u}"
            }
        },{
            "name":"Kleine Dezimalzahlen",
            "vars":{
                "u":"0_9",
                "ns":"0_9_4_^&,${:u}",
                "nb":"${MMmath.round(:ns[0]*100+:ns[1]*10+:u+:ns[2]/10+:ns[3]/100,2)}"
            }
        },{
            "name":"Dezimalzahlen",
            "vars":{
                "u":"0_9",
                "ns":"0_9_10_^${:u}",
                "nb":"${MMmath.round(:ns[0]*100000+:ns[1]*10000+:ns[2]*1000+:ns[3]*100+:ns[4]*10+:u+:ns[5]/10+:ns[6]/100+:ns[7]/1000+:ns[8]/10000+:ns[9]/100000,6)}"
            }
        }
    ],
    "question":"Welche Ziffer steht in der Zahl $$${:nb}$$ an der Einerstelle?",
    "answer":"In $$${:nb}$$ steht an der Einerstelle die Ziffer $$\\color{red}{${:u}}$$.",
    "value":"${:u}"
}
