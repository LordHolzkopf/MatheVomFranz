{
    "ID": "6GD7",
    "title":"Summen von Streckenlängen vergleichen",
    "description":"Abstände, Streckenlängen vergleichen, Dreiecksungleichung, Punkt auf Strecke, Punkt auf Gerade, kleiner, größer, gleich",
    "type":"text",
    "dest":["7EC", "5BA"],
    "keys":["_","_","<",">"],
    "consts":{
        "lettres":"ABCDEFGHJKLMNPQRSTUVW"
    },
    "vars":{"l":"0_${:lettres.length-1}_6_^&",
            "A":"${:lettres[:l[0]]}",
            "B":"${:lettres[:l[1]]}",
            "C":"${:lettres[:l[2]]}",
            "D":"${:lettres[:l[3]]}",
            "E":"${:lettres[:l[4]]}",
            "F":"${:lettres[:l[5]]}",
            "xA":"d-4_-2.5_1",
            "xB":"d2.5_4_1",
            "yA":"d-2_2_1",
            "yB":"d-2_2_1",
            "penteAB":"${(:yB-:yA)/(:xB-:xA)}",
            "ordonneOrigine":"${:yA-:penteAB*:xA}",
            "xE":"d-3_3_1",
            "yE":"d3.5_4_1",
            "xF":"d-3_3_1",
            "yF":"d-3.5_-4_1",
            "xC":"d${:xA+1}_0_1",
            "yC":"${:ordonneOrigine+:penteAB*:xC}",
            "xD":"d${:xC+1}_${:xB-1}_1",
            "yD":"${:ordonneOrigine+:penteAB*:xD}"
        },
    "options":[{
        "name":"Punkt nicht auf der Geraden",
        "consts":{
            "sommesExt":[
                ["\\overline{${:A+:E}}+\\overline{${:E+:C}}","\\overline{${:A+:E}}+\\overline{${:E+:D}}","\\overline{${:A+:E}}+\\overline{${:E+:B}}","\\overline{${:C+:E}}+\\overline{${:E+:D}}","\\overline{${:C+:E}}+\\overline{${:E+:B}}","\\overline{${:D+:E}}+\\overline{${:E+:B}}"],
                ["\\overline{${:A+:F}}+\\overline{${:F+:C}}","\\overline{${:A+:F}}+\\overline{${:F+:D}}","\\overline{${:A+:F}}+\\overline{${:F+:B}}","\\overline{${:C+:F}}+\\overline{${:F+:D}}","\\overline{${:C+:F}}+\\overline{${:F+:B}}","\\overline{${:D+:F}}+\\overline{${:F+:B}}"]],
            "seulesExt":["\\overline{${:A+:C}}","\\overline{${:A+:D}}","\\overline{${:A+:B}}","\\overline{${:C+:D}}","\\overline{${:C+:B}}","\\overline{${:D+:B}}"]
        },
        "vars":{
            "choixP":"0_1",
            "somme":"0_${:sommesExt[:choixP].length-1}"
        },
        "question":"Vergleiche $$${:sommesExt[:choixP][:somme]}$$ und $$${:seulesExt[:somme]}$$.",
        "answer":"$$${:sommesExt[:choixP][:somme]} \\color{red}{>} ${:seulesExt[:somme]}$$",
        "value":">"
        },{
            "name":"Punkt auf der Strecke",
            "consts":{
                "sommes":["\\overline{${:A+:C}}+\\overline{${:C+:D}}","\\overline{${:A+:C}}+\\overline{${:C+:B}}","\\overline{${:A+:D}}+\\overline{${:D+:B}}","\\overline{${:C+:D}}+\\overline{${:D+:B}}"],
                "seules":["\\overline{${:A+:D}}","\\overline{${:A+:B}}","\\overline{${:A+:B}}","\\overline{${:C+:B}}"]
            },
            "vars":{
                 "somme":"0_${:sommes.length-1}"
            },
            "question":"Vergleiche $$${:sommes[:somme]}$$ und $$${:seules[:somme]}$$.",
            "answer":"$$${:sommes[:somme]} \\color{red}{=} ${:seules[:somme]}$$",
            "value":"="
        },{
            "name":"Punkt auf der Geraden, aber nicht auf der Strecke",
            "consts":{
                "sommes":["\\overline{${:C+:A}}+\\overline{${:A+:D}}","\\overline{${:C+:A}}+\\overline{${:A+:B}}","\\overline{${:D+:A}}+\\overline{${:A+:B}}","\\overline{${:D+:C}}+\\overline{${:C+:B}}","\\overline{${:A+:D}}+\\overline{${:D+:C}}","\\overline{${:A+:B}}+\\overline{${:B+:C}}","\\overline{${:A+:B}}+\\overline{${:B+:D}}","\\overline{${:C+:B}}+\\overline{${:B+:D}}"],
                "seules":["\\overline{${:C+:D}}","\\overline{${:C+:B}}","\\overline{${:D+:B}}","\\overline{${:D+:B}}","\\overline{${:A+:C}}","\\overline{${:A+:C}}","\\overline{${:A+:D}}","\\overline{${:C+:D}}"]
            },
            "vars":{
                 "somme":"0_${:sommes.length-1}"
            },
            "question":"Vergleiche $$${:sommes[:somme]}$$ und $$${:seules[:somme]}$$.",
            "answer":"$$${:sommes[:somme]} \\color{red}{>} ${:seules[:somme]}$$",
            "value":">"
        }
    ],
    "figure":{
        "type":"graph",
        "boundingbox":[-6,5,6,-5],
        "axis":false,
        "grid":false,
        "content":[
            ["point", ["${:xA}", "${:yA}"], {"name":"${:A}", "size":3, "face":"x", "label":{"offset":[0,"${:penteAB<0?10:-10}"]}}],
            ["point", ["${:xB}", "${:yB}"], {"name":"${:B}", "size":3, "face":"x", "label":{"offset":[0,"${:penteAB<0?10:-10}"]}}],
            ["point", ["${:xC}", "${:yC}"], {"name":"${:C}", "size":3, "face":"x", "label":{"offset":[0,"${:penteAB<0?10:-10}"]}}],
            ["point", ["${:xD}", "${:yD}"], {"name":"${:D}", "size":3, "face":"x", "label":{"offset":[0,"${:penteAB<0?10:-10}"]}}],
            ["point", ["${:xE}", "${:yE}"], {"name":"${:E}", "size":3, "face":"x", "label":{"offset":[8,3]}}],
            ["point", ["${:xF}", "${:yF}"], {"name":"${:F}", "size":3, "face":"x", "label":{"offset":[8,3]}}],
            ["line", ["${:A}", "${:B}"]]
        ]
    }
}
