    },{
        "name":"Dreistellige natürliche Zahl",
        "vars":{"n13":"1_9_2","n2":"0_9","n0":"${Number(:n13[0]+''+:n2+''+:n13[1])}","z":"0_2","n":"${:fige ? :n0*Math.pow(10,:z) : :n0}"}
    }
    ],
    "question":[
        "${:n}\\times 0.1",
        "${:n}\\times 0.01",
        "${:n}\\times 0.001"
    ],
    "answer":[
        ":question=\\color{red}{${MMmath.round(:n*0.1,3)}}",
        ":question=\\color{red}{${MMmath.round(:n*0.01,3)}}",
        ":question=\\color{red}{${MMmath.round(:n*0.001,3)}}"
    ],
    "value":[
        "${MMmath.round(:n*0.1,3)}",
        "${MMmath.round(:n*0.01,3)}",
        "${MMmath.round(:n*0.001,3)}"
    ]
