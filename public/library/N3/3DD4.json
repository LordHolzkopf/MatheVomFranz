{
    "ID":"3DD4",
    "dest":["8BC", "9BA"],
    "title":"Steigung am Graphen ablesen",
    "description":"Steigung m einer linearen Funktion mit dem Steigungsdreieck am Graphen bestimmen",
    "type":"text",
    "textSize":"small",
    "keys":["_","-","/","_","_","_","_","_"],
    "vars":{"xa":"-4_0","ya":"-4_4","xb":"1_4","yb":"-4_4", "a":"${:yb-:ya}","b":"${:xb-:xa}"},
    "figure":{
        "type":"graph",
        "scale":2.5,
        "boundingbox":[-5,5,5,-5],
        "axis":true,
        "grid":true,
        "content" :[
                ["line",[["${:xa}","${:ya}"],["${:xb}","${:yb}"]]],
                ["segment", [["${:xa}","${:ya}"],["${:xb}","${:ya}"]],{"strokeColor":"#222222"}],
                ["segment", [["${:xb}","${:ya}"],["${:xb}","${:yb}"]],{"strokeColor":"#222222"}]
            ]
        },
    "question":"Bestimme die Steigung der linearen Funktion mithilfe des Steigungsdreiecks.",
    "answer":"Die Steigung ist <span class='red'>$$m=${MMmath.calc(:a+'/('+:b+')')}$$</span>.",
    "value":["${MMmath.calc(:a+'/('+:b+')',true)}"]
}