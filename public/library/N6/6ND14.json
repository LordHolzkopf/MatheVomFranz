            "t":"${:d},${:nd},${:m},${:nm}"
        },
        "question": "Welche dieser Zahlen ist ein <b>Teiler</b> von ${:a}?<br>${utils.shuffle(:t.split(',')).join('; ')}",
        "shortq":"<b>Teiler</b> von ${:a}?<br>${utils.shuffle(:t.split(',')).join('; ')}",
        "answer":"<span class='red'>${:d}</span> ist ein <b>Teiler</b> von ${:a}.",
        "value":"${:d}"
    }]
