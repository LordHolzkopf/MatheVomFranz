{
    "ID":"3DD7",
    "dest":["10BB", "8BE"],
    "title":"Gleichungen grafisch lösen",
    "description":"Gleichungen grafisch lösen: Schnittstellen am Graphen ablesen, Parabel, Gerade, Funktion, quadratische Gleichung, f(x)=k, f(x)=g(x). Keine automatische Auswertung im interaktiven Modus (online/Duell).",
    "type":"latex",
    "keys":["L","A","_","_","_","_","_","_"],
    "textSize":"small",
    "options":[
        {
        "name":"Gleichungen $$f(x)=k$$",
        "consts":{"max1":"${(-5)**2+:b*(-5)+:c}","max2":"${5**2+:b*5+:c,0}","Delta":"${MMmath.round((:b)**2-4*(:c-(:d)),10)}","del":"${MMmath.round(Math.sqrt(:Delta),2)}","x1":"${MMmath.round((-:b-:del)*0.5,1)}","x2":"${MMmath.round((-:b+:del)*0.5,1)}"},
        "vars":{ "b":"d-5_5_1", "c":"d-5_5_1","d":"-5_5","e":"${:max1>0?'('+MMmath.round((-5)**2+:b*(-5)+:c,0)+')':MMmath.round(5**2+:b*5+:c,0)}"},
        "figure":{  
            "type":"graph",
            "boundingbox":[-10,10,10,-10],
            "keepAspect": false,
            "axis":true,
            "grid":true,
            "content" :[
                ["functiongraph", "x**2+${:b}*x+${:c};"]]   
            },
        "question":"\\text{Löse grafisch auf 0,5 genau: } f(x)=${:d}",
        "answer":"${(:Delta>0)? '\\text{Zwei Lösungen: } '+:x1+'\\text{ (abgelesen etwa }'+0.5*MMmath.round(-:b-:del,0)+'\\text{) und }'+:x2+'\\text{ (abgelesen etwa }'+0.5*MMmath.round(-:b+:del,0)+'\\text{)}':'\\text{Keine Lösung}'}"
    },
    {
        "name":"Gleichungen $$f(x)=g(x)$$",
        "consts":{"Delta":"${MMmath.round((:b-:d)**2-4*(:c-(:e)),10)}","del":"${MMmath.round(Math.sqrt(:Delta),2)}","x1":"${MMmath.round((-:b+:d-:del)*0.5,1)}","x2":"${MMmath.round((-:b+:d+:del)*0.5,1)}"},
        "vars":{"b":"0_5", "c":"-4_4","d":"-5_5","e":"-5_5"},
        "figure":{   
            "type":"graph", 
            "boundingbox":[-10,25,15,-10],
            "keepAspect": false,
            "axis":true,
            "grid":true,
            "content" : [
                    ["functiongraph", "x**2+${:b}*x+${:c};"] ,["functiongraph","${:d}*x+${:e}"] 
                ]               
            },
        "question":"\\text{Löse grafisch auf 0,5 genau: } f(x)=g(x)",       
        "answer":"${(:Delta>0)? '\\text{Zwei Lösungen: } '+:x1+'\\text{ (abgelesen etwa }'+0.5*MMmath.round(-:b+:d-:del,0)+'\\text{) und }'+:x2+'\\text{ (abgelesen etwa }'+0.5*MMmath.round(-:b+:d+:del,0)+'\\text{)}':(:Delta==0)? '\\text{Genau eine Lösung: }'+:x1:'\\text{Keine Lösung}'}"
    }
    ]
}