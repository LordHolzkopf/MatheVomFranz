{
    "title":"Multiplier un décimal par 0,1, 0,01, 0,001",
    "description":"multiplier par 0,1, 0,01 ou 0,001, diviser par 10, 100 ou 1000, décimal",
    "ID":"6NE2",
    "params":{"fige":{"label":"Garder les mêmes chiffres significatifs","defaut":false,"fige":["m"]}},
    "dest":["6NE", "5NC", "4NC", "3NB"],
    "vars":{"a":[1,9,99,999,9999], "b":"1_4", "c0":"d0_${:a}_${:b}_^0", "m":"1_999", "q":"-3_1", "c":"${:fige ? MMmath.round(:m*Math.pow(10,:q),4) : :c0}"},
        "options":[{
        "name":"Multiplier un décimal par 0,1",
        "question": ["${:c}\\times 0.1", "0.1\\times ${:c}"],
        "answer":":question=\\color{red}{${MMmath.round(:c*.1,7)}}",
        "value":"${MMmath.round(:c*.1,6)}"
    },{
        "name":"Multiplier un décimal par 0,01",
        "question": ["${:c}\\times 0.01", "0.01\\times ${:c}"],
        "answer":":question=\\color{red}{${MMmath.round(:c*.01,7)}}",
        "value":"${MMmath.round(:c*.01,7)}"
    },{
        "name":"Multiplier un décimal par 0,001",
        "question": ["${:c}\\times 0.001", "0.001\\times ${:c}"],
        "answer":":question=\\color{red}{${MMmath.round(:c*.001,7)}}",
        "value":"${MMmath.round(:c*.001,7)}"
    }
    ]
}