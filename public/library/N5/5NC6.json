    "ID": "5NC6",
    "dest":["7AC"],
    "consigne":"Berechne.",
    "options": [
        {
            "name": "Nur die erste Zahl (Zähler) negativ",
            "vars": {
                "a": "1_10",
                "s": -1,
                "r": "${:s*:a}",
                "d": "1_10",
                "n": "${:a*:d*:s}"
            }
        },
        {
            "name": "Nur die zweite Zahl (Nenner) negativ",
            "vars": {
                "a": "1_10",
                "e": "1_10",
                "s": -1,
                "d": "${:s*:e}",
                "n": "${:a*:e}",
                "r": "${:a*:s}"
            }
        },
        {
            "name": "Beide Zahlen negativ",
            "vars": {
                "r": "1_10",
                "d": "-10_-1",
                "n": "${:r*:d}"
            }
        },
        {
            "name": "Beide Zahlen positiv",
            "vars": {
                "r": "1_10",
                "d": "1_10",
                "n": "${:r*:d}"
            }
        }
    ],
    "question": [
        "${:n}\\div ${(:d<0)?'('+:d+')'::d}",
        "\\dfrac{${:n}}{${:d}}"
    ],
    "answer": [
        ":question=\\color{red}{${:r}}",
        ":question=\\color{red}{${:r}}"
    ],
    "value": "${:r}"
