{
    "title":"Produkte ableiten (Produktregel)",
    "repeat":true,
    "type":"latex",
    "ID":"GA13",
    "description":"Ableitungen mit der Produktregel $$(uv)'=u'v+uv'$$ bestimmen: Produkte mit einer Wurzelfunktion √x oder dem Kehrwert 1/x",
    "dest":["QDB", "QAE"],
    "textSize":"medium",
    "keys":["_","x²","+","-","x","y","z","t"],
    "consts":{"lettres":["x","y","z","t"]},
    "options":[{
        "name":"Mit Quadratwurzel",
        "vars":{"a":"-3_3_2_^&,0","p":"1_3","cx":"0_3","x":"${:lettres[:cx]}","f1":"\\sqrt{${:x}${MMmath.signedNumber(:a[0])}}","f2":"${:x}${:p>1?'^'+:p:''}${MMmath.signedNumber(:a[1])}"},
        "question": "${:x}\\in(${(-:a[0])};\\infty),\\quad \\left(${:f1}\\left(${:f2}\\right)\\right)'",
        "answer":":question=\\color{red}{\\dfrac{${:x}${:p>1?'^'+:p:''}${MMmath.signedNumber(:a[1])}}{2\\sqrt{${:x}${MMmath.signedNumber(:a[0])}}}+${:p==1?''::p==2?'2'+:x:'3'+:x+'^2'}${:f1}}",
        "value":"\\dfrac{${:x}${:p>1?'^'+:p:''}${MMmath.signedNumber(:a[1])}}{2\\sqrt{${:x}${MMmath.signedNumber(:a[0])}}}+${:p==1?''::p==2?'2'+:x:'3'+:x+'^2'}${:f1}"
    },{
        "name":"Mit Kehrwert 1/x",
        "vars":{"a":"-3_3","p":"1_3","cx":"0_3","x":"${:lettres[:cx]}","f":"${:x}${:p>1?'^'+:p:''}${MMmath.signedNumber(:a)}"},
        "question":"${:x}\\neq0,\\quad \\left(\\dfrac{1}{${:x}}\\left(${:f}\\right)\\right)'",
        "answer":":question=\\color{red}{\\dfrac{${MMmath.calc('-('+:f+')+'+:x+'*'+:p+'*'+:x+'^'+(:p-1))}}{${:x}^2}}",
        "value":"\\dfrac{${MMmath.calc('-('+:f+')+'+:x+'*'+:p+'*'+:x+'^'+(:p-1))}}{${:x}^2}"
    }
    ]
}