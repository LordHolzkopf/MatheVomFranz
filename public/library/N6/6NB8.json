{
    "title":"Prüfen, ob zwei Brüche gleich sind",
    "ID":"6NB8",
    "speech":1,
    "description":"Zwei Brüche vergleichen: Sind sie gleich (gleichwertig) oder nicht? Erweitern und Kürzen",
    "dest":["5FB", "6AB"],
    "keys":["o","n"],
    "options":[{
        "name":"Mögliche Abweichung im Zähler",
        "vars":{
            "num":"2_10", "coeff":"2_9", "den":"2_10_^${:num}",
            "choix":"0_1", "delta":"1_${:num-1}",
            "num2":"${:choix==0?:num*:coeff::num*:coeff+:delta}", "den2":"${:den*:coeff}",
            "r":"${:choix==0?'\\text{ja}':'\\text{nein}'}","rl":"${:choix==0?'ja':'nein'}"
        }},
    {
        "name":"Mögliche Abweichung im Nenner",
        "vars":{
            "num":"2_10", "coeff":"2_9", "den":"2_10_^${:num}",
            "choix":"0_1", "delta":"1_${:den-1}",
            "num2":"${:num*:coeff}", "den2":"${:choix==0?:den*:coeff::den*:coeff+:delta}",
            "r":"${:choix==0?'\\text{ja}':'\\text{nein}'}","rl":"${:choix==0?'ja':'nein'}"
        }
    }],
    "audio":"Ist ${MMmath.bruchwort(:num,:den)} gleich ${MMmath.bruchwort(:num2,:den2)}?",
    "question":"\\text{Sind die Brüche }\\dfrac{${:num}}{${:den}}\\text{ und }\\dfrac{${:num2}}{${:den2}}\\text{ gleich?}",
    "shortq":"\\dfrac{${:num}}{${:den}}\\stackrel{!}{=}\\dfrac{${:num2}}{${:den2}}",
    "answer":"\\dfrac{${:num}}{${:den}} ~ \\color{red}{${:choix==0?'=':'\\not ='}}~ \\dfrac{${:num2}}{${:den2}}",
    "value":["${:r}","${:rl}"]
}