        "answer":":question=\\color{red}{${MMmath.signIfOne(:a)}\\${:df}(${:x}) e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}}",
        "value":"${MMmath.signIfOne(:a)}\\${:df}(${:x}) e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}"
    },{
        "name": "Cosinus",
        "vars":{"f":"cos", "df":"sin", "cx":"0_3", "x":"${:lettres[:cx]}", "a":"1_9"},
        "question":["\\left(e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}\\right)'",
        "\\dfrac{d}{d${:x}} e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}"],
        "answer":":question=\\color{red}{${MMmath.signIfOne(-:a)}\\${:df}(${:x}) e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}}",
        "value":"${MMmath.signIfOne(-:a)}\\${:df}(${:x}) e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}"
    },{
        "name": "Tangens (nicht im Kernlehrplan NRW)",
        "vars":{"f":"tan", "a":"1_9", "df":"${:a}${MMmath.signedNumberButOne(:a)}\\tan^2", "cx":"0_3", "x":"${:lettres[:cx]}"},
        "question":["\\left(e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}\\right)'",
        "\\dfrac{d}{d${:x}} e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}"],
        "answer":":question=\\color{red}{\\left(${:df}${:x}\\right) e^{${MMmath.signIfOne(:a)}\\${:f}(${:x})}}",
