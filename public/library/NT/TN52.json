      "value":"${:n**2}"
    },
    {
      "name": "e^(−ln n)",
      "vars": {
        "n": "1_20"
      },
      "question": "e^{-\\ln(${:n})}",
      "answer": ":question=\\color{red}{${MMmath.fractionSimplifiee(1,:n)}}",
      "value":"${MMmath.fractionSimplifiee(1,:n)}"
    },
    {
      "name": "e^(−2 ln n)",
      "vars": {
        "n": "1_20"
      },
      "question": "e^{-2 \\ln(${:n})}",
      "answer": ":question=\\color{red}{${MMmath.fractionSimplifiee(1,:n**2)}}",
      "value":"${MMmath.fractionSimplifiee(1,:n**2)}"
    }
  ]
