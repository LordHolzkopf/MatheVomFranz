    "options":[{
        "name":"ax + b = 0",
        "vars":{"a":"-10_10_^0","b":"-10_10", "l":"0_5","x":"${:lettres[:l]}"},
        "question": "\\text{Löse } ${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=0",
