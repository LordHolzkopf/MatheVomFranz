            ["\\sqrt{x}","nein","\\int_1^z \\sqrt{x}\\,dx=\\dfrac23z\\sqrt{z}-\\dfrac23\\to\\infty"],
            ["\\dfrac{1}{\\sqrt[3]{x}}","nein","\\int_1^z x^{-\\frac13}\\,dx=\\dfrac32\\sqrt[3]{z^2}-\\dfrac32\\to\\infty"],
