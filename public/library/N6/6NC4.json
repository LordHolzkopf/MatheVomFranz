{
    "title":"Ergebnisse überschlagen",
    "description":"Überschlag, Überschlagsrechnung, ungefähres Ergebnis einer Summe (Addition), Differenz (Subtraktion) oder eines Produkts (Multiplikation), runden",
    "speech":1,
    "dest":["6CC", "5CF"],
    "options":[{
        "name":"Überschlag einer Summe",
        "vars":{"a":[10,100,1000,10000],
            "c":"1_14", "d":"1_14",
            "e":"d-0.25_0.25_3","f":"d-0.25_0.25_3",
        "n1":"${:a*:c}","n2":"${:a*:d}","p1":"${MMmath.round(:n1+:a*:e,0)}","p2":"${MMmath.round(:n2+:a*:f,0)}",
        "rep":"${:n1+:n2}"
        },
        "question": "${:p1}+${:p2}\\approx ?",
        "shortq": "${:p1}+${:p2}\\approx \\colorbox{#ececec}{\\quad\\quad}",
        "audio": "Überschlage ${:p1} ( ) plus ( ) ${:p2}.",
        "answer":":question \\approx \\color{red}{${:rep}} \\color{blue}{=${:n1}+${:n2}}",
        "value":"${:rep}"
    },
    {
        "name":"Überschlag einer Differenz",
        "vars":{"a":[10,100,1000,10000],
            "c":"1_14", "d":"${:c+1}_16",
            "e":"d-0.25_0.25_3","f":"d-0.25_0.25_3",
        "n1":"${:a*:c}","n2":"${:a*:d}","p1":"${MMmath.round(:n1+:a*:e,0)}","p2":"${MMmath.round(:n2+:a*:f,0)}",
        "rep":"${:n2-:n1}"
        },
        "question": "${:p2}-${:p1}\\approx ?",
        "shortq": "${:p2}-${:p1}\\approx \\colorbox{#ececec}{\\quad\\quad}",
        "audio": "Überschlage ${:p2} ( ) minus ( ) ${:p1}.",
        "answer":":question \\approx \\color{red}{${:rep}} \\color{blue}{=${:n2}-${:n1}}",
        "value":"${:rep}"
    },
    {
        "name":"Überschlag eines Produkts",
        "vars":{"a":[10,100,1000],"b":[10,100,1000],
            "c":"1_9", "d":"2_9",
            "e":"d-0.25_0.25_3","f":"d-0.25_0.25_3",
        "n1":"${:a*:c}","n2":"${:b*:d}","p1":"${MMmath.round(:n1+:a*:e,0)}","p2":"${MMmath.round(:n2+:b*:f,0)}",
        "rep":"${:n2*:n1}"
        },
        "question": "${:p1}\\times${:p2}\\approx ?",
        "shortq": "${:p1}\\times${:p2}\\approx  \\colorbox{#ececec}{\\quad\\quad}",
        "audio": "Überschlage ${:p1} ( ) mal ( ) ${:p2}.",
        "answer":":question \\approx \\color{red}{${:rep}} \\color{blue}{=${:n1}\\times ${:n2}}",
        "value":"${:rep}"
    }
    ]
}