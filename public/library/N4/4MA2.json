{
    "title":"Mit zusammengesetzten Größen rechnen",
    "type":"text",
    "ID":"4MA2",
    "description":"Aus zwei Größen die dritte berechnen: Geschwindigkeit, Weg und Zeit (v = s : t), Dichte, Masse und Volumen, Durchfluss, Konzentration",
    "dest":["WDB", "7BB"],
    "consts":{
        "unitetemps":["h","min","s"],
        "prefixes":["k","h","da","","d","c","m"],
        "unites":["m","g","L"],
        "mv":[
            ["Ebenholz", 1150],
            ["Luft",1],
            ["Wasser",1000],
            ["Benzin",750],
            ["Aluminium",2700],
            ["Silber",10500],
            ["Gold",19300],
            ["Öl",920],
            ["Balsaholz",140],
            ["Eschenholz",740],
            ["Eichenholz",700],
            ["Kiefernholz",500],
            ["Platanenholz",650],
            ["Tannenholz",450],
            ["Propan",2],
            ["Milch",1030],
            ["Glas",2530],
            ["Baumwolle",45],
            ["Diamant",3500],
            ["Beton",2200],
            ["Kupfer",9000],
            ["Zink",7000],
            ["Eisen",7860]
        ]
    },
    "options":[{
        "name":"Geschwindigkeit in m/s",
        "vars":{
            "v":"1_10",
            "t":"1_10",
            "d":"${:v*:t}",
            "ud":"m",
            "ut":"s",
            "uv":"${:ud}/${:ut}"
        },
        "question": [
            "Geschwindigkeit = $$${:v}$$ ${:uv}, Zeit = $$${:t}$$ ${:ut},<br>also Strecke = … ${:ud}",
            "Strecke = $$${:d}$$ ${:ud}, Zeit = $$${:t}$$ ${:ut},<br>also Geschwindigkeit = … ${:uv}",
            "Geschwindigkeit = $$${:v}$$ ${:uv}, Strecke = $$${:d}$$ ${:ud},<br>also Zeit = … ${:ut}"
        ],
        "answer":[
            "$$s=v\\times t=${:v}$$ ${:uv}$$\\times${:t}$$ ${:ut}=$$\\color{red}{${:d}}$$ ${:ud}",
            "$$v=\\dfrac{s}{t}=\\dfrac{${:d}\\text{ ${:ud}}}{${:t}\\text{ ${:ut}}}=\\color{red}{${:v}}\\text{ ${:uv}}$$",
            "$$t=\\dfrac{s}{v}=\\dfrac{${:d}\\text{ ${:ud}}}{${:v}\\text{ ${:uv}}}=\\color{red}{${:t}}\\text{ ${:ut}}$$"
        ],
        "value":["${:d}","${:v}","${:t}"]
    },{
        "name":"Geschwindigkeit in km/h",
        "vars":{
            "v":[30,50,60,70,80,90,100,110,120,130],
            "t":[1,1.5,2,2.5,3,3.5,4,4.5,5,6,7,8,9],
            "d":"${:v*:t}",
            "ud":"km",
            "ut":"h",
            "uv":"${:ud}/${:ut}"
        },
        "question": [
            "Geschwindigkeit = $$${:v}$$ ${:uv}, Zeit = $$${:t}$$ ${:ut},<br>also Strecke = … ${:ud}",
            "Strecke = $$${:d}$$ ${:ud}, Zeit = $$${:t}$$ ${:ut},<br>also Geschwindigkeit = … ${:uv}",
            "Geschwindigkeit = $$${:v}$$ ${:uv}, Strecke = $$${:d}$$ ${:ud},<br>also Zeit = … ${:ut}"
        ],
        "answer":[
            "$$s=v\\times t=${:v}$$ ${:uv}$$\\times${:t}$$ ${:ut}=$$\\color{red}{${:d}}$$ ${:ud}",
            "$$v=\\dfrac{s}{t}=\\dfrac{${:d}\\text{ ${:ud}}}{${:t}\\text{ ${:ut}}}=\\color{red}{${:v}}\\text{ ${:uv}}$$",
            "$$t=\\dfrac{s}{v}=\\dfrac{${:d}\\text{ ${:ud}}}{${:v}\\text{ ${:uv}}}=\\color{red}{${:t}}\\text{ ${:ut}}$$"
        ],
        "value":["${:d}","${:v}","${:t}"]
    },{
        "name":"Dichte in $$kg/m^3$$ (schwer)",
        "vars":{
            "choixMv":"0_22",
            "de":"von ${:mv[:choixMv][0]}",
            "v":"${:mv[:choixMv][1]}",
            "t":[1,0.1,0.01,0.001,2,0.2,0.02,0.002,3,0.3,5,0.5,0.05],
            "d":"${:v*:t}",
            "ud":"kg",
            "ut":"m^3",
            "uv":"${:ud}/${:ut}"
        },
        "question": [
            "Dichte ${:de} = $$${:v}~${:uv}$$, Volumen = $$${:t}~${:ut}$$,<br>also Masse = … $$${:ud}$$",
            "Masse ${:de} = $$${:d}~${:ud}$$, Volumen = $$${:t}~${:ut}$$,<br>also Dichte = … $$${:uv}$$",
            "Dichte ${:de} = $$${:v}~${:uv}$$, Masse = $$${:d}~${:ud}$$,<br>also Volumen = … $$${:ut}$$"
        ],
        "answer":[
            "$$m=\\rho\\times V=${:v}~${:uv}\\times${:t}~${:ut}$$=$$\\color{red}{${:d}}~${:ud}$$",
            "$$\\rho=\\dfrac{m}{V}=\\dfrac{${:d}~${:ud}}{${:t}~${:ut}}=\\color{red}{${:v}}~${:uv}$$",
            "$$V=\\dfrac{m}{\\rho}=\\dfrac{${:d}~${:ud}}{${:v}~${:uv}}=\\color{red}{${:t}}~${:ut}$$"
        ],
        "value":["${:d}","${:v}","${:t}"]
    },{
        "name":"Durchfluss (Zahlen bis 200) und Zeit (1 bis 10)",
        "vars":{
            "v":"1_200",
            "t":"1_10",
            "d":"${:v*:t}",
            "ud":"L",
            "ut":["h","min", "s"],
            "uv":"${:ud}/${:ut}"
        },
        "question": [
            "Durchfluss = $$${:v}~${:uv}$$, Zeit = $$${:t}~${:ut}$$,<br>also Volumen = … $$${:ud}$$",
            "Volumen = $$${:d}~${:ud}$$, Zeit = $$${:t}~${:ut}$$,<br>also Durchfluss = … $$${:uv}$$",
            "Durchfluss = $$${:v}~${:uv}$$, Volumen = $$${:d}~${:ud}$$,<br>also Zeit = … $$${:ut}$$"
        ],
        "answer":[
            "$$V=D\\times t=${:v}~${:uv}\\times${:t}~${:ut}$$=$$\\color{red}{${:d}}~${:ud}$$",
            "$$D=\\dfrac{V}{t}=\\dfrac{${:d}~${:ud}}{${:t}~${:ut}}=\\color{red}{${:v}}~${:uv}$$",
            "$$t=\\dfrac{V}{D}=\\dfrac{${:d}~${:ud}}{${:v}~${:uv}}=\\color{red}{${:t}}~${:ut}$$"
        ],
        "value":["${:d}","${:v}","${:t}"]
    },{
        "name":"Konzentration einer Lösung",
        "vars":{
            "v":"1_10",
            "t":"1_10",
            "d":"${:v*:t}",
            "ud":["mg","g"],
            "ut":"L",
            "uv":"${:ud}/${:ut}"
        },
        "question": [
            "Konzentration = $$${:v}~${:uv}$$, Volumen = $$${:t}~${:ut}$$,<br>also Masse = … $$${:ud}$$",
            "Masse = $$${:d}~${:ud}$$, Volumen = $$${:t}~${:ut}$$,<br>also Konzentration = … $$${:uv}$$",
            "Konzentration = $$${:v}~${:uv}$$, Masse = $$${:d}~${:ud}$$,<br>also Volumen = … $$${:ut}$$"
        ],
        "answer":[
            "$$m=C\\times V=${:v}~${:uv}\\times${:t}~${:ut}$$=$$\\color{red}{${:d}}~${:ud}$$",
            "$$C=\\dfrac{m}{V}=\\dfrac{${:d}~${:ud}}{${:t}~${:ut}}=\\color{red}{${:v}}~${:uv}$$",
            "$$V=\\dfrac{m}{C}=\\dfrac{${:d}~${:ud}}{${:v}~${:uv}}=\\color{red}{${:t}}~${:ut}$$"
        ],
        "value":["${:d}","${:v}","${:t}"]
    }]
}