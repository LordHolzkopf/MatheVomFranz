        "answer":"$$(${:nb}${:operations[:op1]}${:n1})${:operations[:op2]}${:n2}${:operations[:op3]} ${:n3<11?:n3::nb}=\\color{red}{${MMmath.calc('('+:nb+:opes[:op1]+:n1+')'+:opes[:op2]+:n2+:opes[:op3]+(:n3<11?:n3::nb))}}$$",
        "value":"${MMmath.calc('('+:nb+:opes[:op1]+:n1+')'+:opes[:op2]+:n2+:opes[:op3]+(:n3<11?:n3::nb))}"
