{
    "ID":"5AA3",
    "title":"Wiederholung verstehen",
    "type":"text",
    "description":"Scratch, Programmieren, Schleife, wiederhole … mal, Wiederholung, Gesamtzahl der Schritte bestimmen, Multiplikation",
    "dest":["WGB"],
    "consts":{
        "sens":["turnright", "turnleft"]
    },
    "vars":{"d0":"1_10", "t":"${:d0*10}"},
    "options":[
        {
            "name":"Einfache Wiederholung",
            "vars":{"x":"0_10","y":"1_10"},
            "figure":{
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "wiederhole (${:x}) mal",
                    "gehe (${:y}) er Schritt",
                    "Ende"
                ]
            }
        },{
            "name":"Wiederholen und drehen",
            "vars":{"x":"0_10","y":"1_10", "s0":"0_1"},
            "figure":{
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "wiederhole (${:x}) mal",
                    "gehe (${:y}) er Schritt",
                    "drehe dich @${:sens[:s0]} um (${:t}) Grad",
                    "Ende"
                ]
            }
        },{
            "name":"Wiederholen und drehen (2)",
            "vars":{"x":"0_10","y":"1_10", "s0":"0_1"},
            "figure":{
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "wiederhole (${:x}) mal",
                    "drehe dich @${:sens[:s0]} um (${:t}) Grad",
                    "gehe (${:y}) er Schritt",
                    "Ende"
                ]
            }
        },{
            "consts":{
                "mots":["Hallo", "Willkommen","Hi","Hello","Ich mag Erdbeeren","Ich fahre gern Fahrrad"],
                "distracteurs":["sage [${:mots[:p]}] für (${:d0}) Sekunden",
        "ändere Größe um (${:t})", "warte (${:d0}) Sekunden", "denke ((${:d0}) * (${:t})) für (2) Sekunden", "drehe dich @turnleft um (${:t}) Grad", "drehe dich @turnright um (${:t}) Grad"],
        "actions":["gehe (${:y}) er Schritt", "${:distracteurs[:s0]}", "${:distracteurs[:s1]}"]
        },
            "name":"Wiederholen mit 2 ablenkenden Blöcken",
            "vars":{"p":"0_5", "x":"0_10","y":"1_10", "s0":"0_5", "s1":"0_5_^${:s0}", "a":"0_2_3_^&"},
            "figure":{
                "type":"scratch",
                "content":[
                    "Wenn @greenFlag angeklickt wird",
                    "wiederhole (${:x}) mal",
                    "${:actions[:a[0]]}",
                    "${:actions[:a[1]]}",
                    "${:actions[:a[2]]}",
                    "Ende"
                ]
            }
        }],
    "question":"Wie viele Schritte geht die Figur insgesamt?",
    "answer":"Die Figur geht insgesamt <span class='red'>${:x*:y}</span> Schritte.",
    "value":"${:x*:y}"
}
