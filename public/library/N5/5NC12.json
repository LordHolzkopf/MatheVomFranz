{
    "title":"Terme mit Bruchstrich berechnen",
    "ID":"5NC12",
    "description":"Bruchstrich als Geteiltzeichen: erst Zähler und Nenner ausrechnen, dann dividieren. Rechenreihenfolge, Terme berechnen, ganzzahlige Ergebnisse",
    "consigne":"Berechne.",
    "dest":["5CA"],
    "options":[{
        "name":"Addition im Zähler",
        "vars":{
            "resultat":"2_10",
            "denom":"2_10",
            "produit":"${:resultat*:denom}",
            "terme1":"1_${Math.min(15,:produit)}",
            "terme2":"${:produit-:terme1}"
        },
        "question": "\\dfrac{${:terme1}+${:terme2}}{${:denom}}=?",
        "answer":":question|2=\\color{green}{\\dfrac{${:produit}}{${:denom}}}=\\color{red}{${:resultat}}",
        "value":"${:resultat}"
    },{
        "name":"Subtraktion im Zähler",
        "vars":{
            "resultat":"2_10",
            "denom":"2_10",
            "produit":"${:resultat*:denom}",
            "terme1":"${:produit}_${:produit+10}",
            "terme2":"${:terme1-:produit}"
        },
        "question": "\\dfrac{${:terme1}-${:terme2}}{${:denom}}=?",
        "answer":":question|2=\\color{green}{\\dfrac{${:produit}}{${:denom}}}=\\color{red}{${:resultat}}",
        "value":"${:resultat}"
    },{
        "name":"Multiplikation im Zähler",
        "vars":{
            "resultat":"2_10",
            "denom":"2_10",
            "produit":"${:resultat*:denom}",
            "facteur1":"${MMmath.unDiviseur(:produit)}",
            "facteur2":"${:produit/:facteur1}"
        },
        "question": "\\dfrac{${:facteur1}\\times${:facteur2}}{${:denom}}=?",
        "answer":":question|2=\\color{green}{\\dfrac{${:produit}}{${:denom}}}=\\color{red}{${:resultat}}",
        "value":"${:resultat}"
    },{
        "name":"Rechnungen in Zähler und Nenner (1: Addition)",
        "vars":{
            "resultat":"2_10",
            "denom":"1_10",
            "denterme1":"1_20",
            "denterme2":"${1-:denterme1}_${10-:denterme1}",
            "produit":"${:resultat*(:denterme1+:denterme2)}",
            "terme1":"1_${Math.min(15,:produit)}",
            "terme2":"${:produit-:terme1}"
        },
        "question": "\\dfrac{${:terme1}+${:terme2}}{${:denterme1}${MMmath.signedNumber(:denterme2)}}=?",
        "answer":":question|2=\\color{green}{\\dfrac{${:produit}}{${:denterme1+:denterme2}}}=\\color{red}{${:resultat}}",
        "value":"${:resultat}"
    },{
        "name":"Rechnungen in Zähler und Nenner (2: Subtraktion)",
        "vars":{
            "resultat":"2_10",
            "denom":"1_10",
            "denterme1":"1_20",
            "denterme2":"${1-:denterme1}_${10-:denterme1}",
            "produit":"${:resultat*(:denterme1+:denterme2)}",
            "terme1":"${:produit}_${:produit+10}",
            "terme2":"${:terme1-:produit}"
        },
        "question": "\\dfrac{${:terme1}-${:terme2}}{${:denterme1}${MMmath.signedNumber(:denterme2)}}=?",
        "answer":":question|2=\\color{green}{\\dfrac{${:produit}}{${:denterme1+:denterme2}}}=\\color{red}{${:resultat}}",
        "value":"${:resultat}"
    },{
        "name":"Rechnungen in Zähler und Nenner (3: Multiplikation)",
        "vars":{
            "resultat":"2_10",
            "denom":"1_10",
            "denterme1":"1_20",
            "denterme2":"${1-:denterme1}_${10-:denterme1}",
            "produit":"${:resultat*(:denterme1+:denterme2)}",
            "facteur1":"${MMmath.unDiviseur(:produit)}",
            "facteur2":"${:produit/:facteur1}"
        },
        "question": "\\dfrac{${:facteur1}\\times${:facteur2}}{${:denterme1}${MMmath.signedNumber(:denterme2)}}=?",
        "answer":":question|2=\\color{green}{\\dfrac{${:produit}}{${:denterme1+:denterme2}}}=\\color{red}{${:resultat}}",
        "value":"${:resultat}"
    }
    ]
}
