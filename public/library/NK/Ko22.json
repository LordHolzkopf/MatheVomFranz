        "question": "\\text{Löse } ${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${MMmath.signIfOne(:c)}${:x}${MMmath.signedNumber(:d)}",
        "shortq":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${MMmath.signIfOne(:c)}${:x}${MMmath.signedNumber(:d)}",
        "answer":"${MMmath.signIfOne(:a)}${:x}${MMmath.signedNumber(:b)}=${MMmath.signIfOne(:c)}${:x}${MMmath.signedNumber(:d)} \\quad \\Rightarrow \\quad \\color{red}{${:a-:c==0?(:b==:d?'\\text{unendlich viele Lösungen}':'\\text{keine Lösung}')::x+'='+MMmath.calc('('+:d+'-('+:b+'))/(('+:a+')-('+:c+'))')}}",
        "value":"${:a-:c==0?(:b==:d?'unendlich viele Lösungen':'keine Lösung'):MMmath.calc('('+:d+'-('+:b+'))/(('+:a+')-('+:c+'))')}"
    }]
