{
    "ID": "TP11",
    "title": "Binomialkoeffizienten berechnen",
    "description": "Binomialkoeffizienten (n über k) für einfache Werte berechnen: Binomialkoeffizient, Fakultät, Kombinatorik, Bernoulli-Kette, Binomialverteilung",
    "type": "text",
    "repeat": true,
    "dest":["QIB", "QIA"],
    "options": [
        {
            "name": "Einfache Fälle",
            "vars": {
                "n": "2_10",
                "k": [1,"${:n-1}"]
            }
        },
        {
            "name":"Weitere Fälle",
            "vars": {
                "n": "4_10",
                "k": "2_${:n-2}"
            }
        }
    ],
    "question":"Berechne $$\\dbinom{${:n}}{${:k}}$$.",
    "answer":"$$\\dbinom{${:n}}{${:k}}=\\dfrac{${:n}!}{${:k}!\\left(${:n}-${:k}\\right)!}=\\color{red}{${MMmath.factorial(:n)/(MMmath.factorial(:k)*MMmath.factorial(:n-:k))}}$$",
    "value":"${MMmath.factorial(:n)/(MMmath.factorial(:k)*MMmath.factorial(:n-:k))}"
}