{
    "title":"Doppeltes, Quadrat, Dreifaches, dritte Potenz",
    "type":"text",
    "speech":1,
    "description":"Begriffe unterscheiden: das Doppelte und das Quadrat, das Dreifache und die dritte Potenz (Kubikzahl) einer Zahl; Potenzen, hoch 2, hoch 3",
    "textSize":"medium",
    "dest":["5CC"],
    "consts":{
        "vocab":["das Doppelte", "das Quadrat", "das Dreifache", "die dritte Potenz"],
        "coef":[2,2,3,3]
    },
    "options":[
        {
            "name":"Doppeltes, Quadrat",
            "vars":{"choix":"0_1", "n":"1_10"}
        },
        {
            "name":"Dreifaches, dritte Potenz",
            "vars":{"choix":"2_3", "n":"1_${:choix<3?10:5}"}
        },
        {
            "name":"Potenzschreibweise: hoch 2, hoch 3",
            "vars":{"choix":[2,3], "n":"1_5"},
            "question":"$$:n^:choix=?$$",
            "answer":"$$:n^:choix=\\color{green}{${Array(:choix).fill(:n).join('\\times')}}=\\color{red}{${:n**:choix}}$$",
            "value":"${:n**:choix}"
        }
    ],
    "question":"Wie viel ist ${:vocab[:choix]} von $$${:n}$$?",
    "audio":"Wie viel ist ${:vocab[:choix]} von ${:n}?",
    "shortq":"${:vocab[:choix].charAt(0).toUpperCase()+:vocab[:choix].slice(1)} von $$${:n}$$?",
    "answer":"${:vocab[:choix].charAt(0).toUpperCase()+:vocab[:choix].slice(1)} von ${:n} ist $$\\color{green}{${:n}${:choix==0||:choix==2?'\\times':'^'}${:coef[:choix]}}=\\color{red}{${:choix==0||:choix==2?:n*:coef[:choix]::n**:coef[:choix]}}$$",
    "value":"${:choix==0||:choix==2?:n*:coef[:choix]::n**:coef[:choix]}"
}