        "shortq": "(${MMmath.signIfOne(:a)+:x}${MMmath.signedNumber(:b)})(${MMmath.signIfOne(:c)+:x}${MMmath.signedNumber(:d)})",
        "answer":"(${MMmath.signIfOne(:a)+:x}${MMmath.signedNumber(:b)})(${MMmath.signIfOne(:c)+:x}${MMmath.signedNumber(:d)})=\\color{red}{${MMmath.signIfOne(:a*:c)+:x}^2${(:a*:d+:b*:c!=0)?MMmath.signedNumberButOne(:a*:d+:b*:c)+:x:''}${MMmath.signedNumber(:b*:d)}}",
        "value":"${MMmath.signIfOne(:a*:c)+:x}^2${(:a*:d+:b*:c!=0)?MMmath.signedNumberButOne(:a*:d+:b*:c)+:x:''}${MMmath.signedNumber(:b*:d)}"
    },{
        "name":"Variable mal Summe",
        "vars":{"l":"0_4","x":"${:lettres[:l]}", "a":"-10_10_^0","b":"-10_10_^0","c":"-10_10_^0"},
        "question": ["${MMmath.signIfOne(:a)}${:x}(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})","${MMmath.signIfOne(:a)}${:x}(${:c}${MMmath.signedNumberButOne(:b)}${:x})"],
        "shortq":["${MMmath.signIfOne(:a)}${:x}(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})","${MMmath.signIfOne(:a)}(${:c}${MMmath.signedNumberButOne(:b)}${:x})"],
        "answer":["${MMmath.signIfOne(:a)}${:x}(${MMmath.signIfOne(:b)}${:x}${MMmath.signedNumber(:c)})=\\color{red}{${MMmath.signIfOne(:a*:b)}${:x}^2${MMmath.signedNumber(:a*:c)}${:x}}","${MMmath.signIfOne(:a)}${:x}(${:c}${MMmath.signedNumberButOne(:b)}${:x})=\\color{red}{${:a*:c}${:x}${MMmath.signedNumberButOne(:a*:b)}${:x}^2}"],
        "value":"${MMmath.calc(:a+'*'+:x+'*('+:b+')*'+:x+'+('+:a+')*('+:c+')*'+:x)}"
