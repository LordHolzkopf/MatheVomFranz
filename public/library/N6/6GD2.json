{
    "title":"Parallele und senkrechte Geraden erkennen",
    "ID":"6GD2",
    "dest":["5BA"],
    "type":"text",
    "repeat":5,
    "keys": [
        "o",
        "n",
        "_",
        "_",
        "_",
        "_",
        "_",
        "_"
    ],
    "description":"Nach Augenmaß erkennen, ob Geraden parallel oder senkrecht zueinander sind oder sich schneiden, Parallelität, Orthogonalität",
    "options":[
        {
            "name":"Parallel",
            "vars":{
                "par":[true,false],
                "xA":-3,
                "yA":"-3_3",
                "dangle1":"-9_8${:par?'_^0,-9':''}",
                "angle1":"${:dangle1*10}",
                "xB":"${:xA+Math.cos(:angle1/180*Math.PI)}",
                "yB":"${:yA+Math.sin(:angle1/180*Math.PI)}",
                "xC":"0_3",
                "yC":"-3_3",
                "dangle2":"${:par?:dangle1:'-9_9_^'+:dangle1}",
                "angle2":"${:dangle2*10}",
                "xD":"${:xC+Math.cos(:angle2/180*Math.PI)}",
                "yD":"${:yC+Math.sin(:angle2/180*Math.PI)}"
            },
            "question":"Sehen die Geraden parallel aus?",
            "answer":"${:par?'Ja, die Geraden sehen parallel aus.':'Nein, die Geraden sehen nicht parallel aus.'}",
            "value":["${:par?'ja':'nein'}","${:par?'j':'n'}"]
        },{
            "name":"Senkrecht",
            "vars":{
                "perp":[true,false],
                "xA":-4,
                "yA":"-4_4",
                "dangle1":"-9_8${:perp?'_^0,-9':''}",
                "angle1":"${:dangle1*10}",
                "xB":"${:xA+Math.cos(:angle1/180*Math.PI)}",
                "yB":"${:yA+Math.sin(:angle1/180*Math.PI)}",
                "xC":"2_4",                
                "yC":"-4_4",
                "dangle2":"${:perp?:dangle1+9:'-9_8_^'+(:dangle1+9)+','+(:dangle1-9)}",
                "angle2":"${:dangle2*10}",
                "xD":"${:xC+Math.cos(:angle2/180*Math.PI)}",
                "yD":"${:yC+Math.sin(:angle2/180*Math.PI)}"
            },
            "question":"Sehen die Geraden senkrecht zueinander aus?",
            "answer":"${:perp?'Ja, die Geraden sehen senkrecht zueinander aus.':'Nein, die Geraden sehen nicht senkrecht zueinander aus.'}",
            "value":["${:perp?'ja':'nein'}","${:perp?'j':'n'}"]
        },{
            "name":"Lage der Geraden",
            "vars":{
                "relation":["par","per","sec"],
                "xA":-4,
                "yA":"-4_4",
                "dangle1":"-9_8${['par','per'].includes(:relation)?'_^0,-9':''}",
                "angle1":"${:dangle1*10}",
                "xB":"${:xA+Math.cos(:angle1/180*Math.PI)}",
                "yB":"${:yA+Math.sin(:angle1/180*Math.PI)}",
                "xC":"0_3",
                "yC":"-3_3",
                "dangle2":"${:relation=='par'?:dangle1::relation=='per'?:dangle1+9:'-9_9_^'+(:dangle1+9)+','+(:dangle1-9)}",
                "angle2":"${:dangle2*10}",
                "xD":"${:xC+Math.cos(:angle2/180*Math.PI)}",
                "yD":"${:yC+Math.sin(:angle2/180*Math.PI)}"
            },
            "question":"Sind die Geraden parallel, senkrecht zueinander oder schneiden sie sich schräg (nicht senkrecht)?",
            "answer":"Die Geraden sind <span class='red'>${:relation=='par'?'parallel'::relation=='per'?'senkrecht zueinander':'schneidend, aber nicht senkrecht zueinander'}</span>.",
            "value":"${:relation=='par'?'parallel'::relation=='per'?'senkrecht':'schneidend'}"
        }
    ],
    "figure":{
        "type":"graph",
        "axis":false,
        "boundingbox":[-10,5,10,-5],
        "content":[
            ["point",["${:xA}","${:yA}"],{"name":"A","visible":false,"withLabel":false}],
            ["point",["${:xB}","${:yB}"],{"name":"B","visible":false,"withLabel":false}],
            ["line",["A","B"]],
            ["point",["${:xC}","${:yC}"],{"name":"C","visible":false,"withLabel":false}],
            ["point",["${:xD}","${:yD}"],{"name":"D","visible":false,"withLabel":false}],
            ["line",["C","D"],{"color":"red"}]
        ]
    }
}