    "options": [
        {
            "name": "Seite berechnen bei γ = 60°",
            "vars": {"i":"0_9","sw":"0_1","a":"${:T60[:i][:sw]}","b":"${:T60[:i][1-:sw]}","c":"${:T60[:i][2]}","u":["cm","dm","m","mm"]},
            "question": "In einem Dreieck ist $$a=${:a}$$ ${:u}, $$b=${:b}$$ ${:u} und $$\\gamma=60^\\circ$$. Berechne $$c$$ (in ${:u}). Es gilt $$\\cos 60^\\circ=\\frac{1}{2}$$.",
            "shortq": "$$a=${:a}$$, $$b=${:b}$$, $$\\gamma=60^\\circ$$: $$c=?$$",
            "answer": "$$c^2=a^2+b^2-2ab\\cos\\gamma=${:a*:a}+${:b*:b}-2\\cdot${:a}\\cdot${:b}\\cdot\\frac{1}{2}=${:a*:a}+${:b*:b}-${:a*:b}=${:c*:c}$$<br>$$c=\\color{red}{${:c}}$$ ${:u}",
            "value": "${:c}"
        },
        {
            "name": "Seite berechnen bei γ = 120°",
            "vars": {"i":"0_6","sw":"0_1","a":"${:T120[:i][:sw]}","b":"${:T120[:i][1-:sw]}","c":"${:T120[:i][2]}","u":["cm","dm","m","mm"]},
            "question": "In einem Dreieck ist $$a=${:a}$$ ${:u}, $$b=${:b}$$ ${:u} und $$\\gamma=120^\\circ$$. Berechne $$c$$ (in ${:u}). Es gilt $$\\cos 120^\\circ=-\\frac{1}{2}$$.",
            "shortq": "$$a=${:a}$$, $$b=${:b}$$, $$\\gamma=120^\\circ$$: $$c=?$$",
            "answer": "$$c^2=a^2+b^2-2ab\\cos\\gamma=${:a*:a}+${:b*:b}-2\\cdot${:a}\\cdot${:b}\\cdot\\left(-\\frac{1}{2}\\right)=${:a*:a}+${:b*:b}+${:a*:b}=${:c*:c}$$<br>$$c=\\color{red}{${:c}}$$ ${:u}",
            "value": "${:c}"
        },
        {
            "name": "Quadrat der dritten Seite (Kosinussatz)",
            "consts": {"W":[60,90,120],"CT":["\\frac{1}{2}","0","-\\frac{1}{2}"],"F":[-1,0,1]},
            "vars": {"j":"0_2","a":"2_9","b":"2_9","c2":"${:a*:a+:b*:b+:F[:j]*:a*:b}"},
            "question": "In einem Dreieck ist $$a=${:a}$$ cm, $$b=${:b}$$ cm und $$\\gamma=${:W[:j]}^\\circ$$. Berechne $$c^2$$ (in cm²). Es gilt $$\\cos ${:W[:j]}^\\circ=${:CT[:j]}$$.",
            "shortq": "$$a=${:a}$$, $$b=${:b}$$, $$\\gamma=${:W[:j]}^\\circ$$: $$c^2=?$$",
            "answer": "$$c^2=${:a}^2+${:b}^2-2\\cdot${:a}\\cdot${:b}\\cdot${:j==2?'\\left(-\\frac{1}{2}\\right)'::CT[:j]}=${:a*:a}+${:b*:b}${:j==1?'':(:j==0?'-':'+')+(:a*:b)}=\\color{red}{${:c2}}$$",
            "value": "${:c2}"
        },
        {
            "name": "Winkel aus drei Seiten berechnen",
            "vars": {"i":"0_20","sw":"0_1","a":"${:G[:i][:sw]}","b":"${:G[:i][1-:sw]}","c":"${:G[:i][2]}","g":"${:G[:i][3]}","u":["cm","dm","m","mm"]},
            "question": "Ein Dreieck hat die Seiten $$a=${:a}$$ ${:u}, $$b=${:b}$$ ${:u} und $$c=${:c}$$ ${:u}. Wie groß ist der Winkel $$\\gamma$$ (in Grad)?",
            "shortq": "$$a=${:a}$$, $$b=${:b}$$, $$c=${:c}$$: $$\\gamma=?$$",
            "answer": "$$\\cos\\gamma=\\dfrac{a^2+b^2-c^2}{2ab}=\\dfrac{${:a*:a}+${:b*:b}-${:c*:c}}{${2*:a*:b}}=\\dfrac{${:a*:a+:b*:b-:c*:c}}{${2*:a*:b}}=${:g==60?'\\frac{1}{2}':(:g==90?'0':'-\\frac{1}{2}')}$$, also $$\\gamma=\\color{red}{${:g}^\\circ}$$",
            "value": ["${:g}","${:g}\\degree","${:g}°"]
        },
        {
            "name": "Seite mit dem Sinussatz berechnen",
            "vars": {"i":"0_11","t":"1_4","a":"${:S[:i][2]*:t}","k":"${:a*:S[:i][3]/:S[:i][4]}","u":["cm","dm","m","mm"]},
            "question": "In einem Dreieck ist $$a=${:a}$$ ${:u}, $$\\alpha=${:S[:i][0]}^\\circ$$ und $$\\beta=${:S[:i][1]}^\\circ$$. Berechne $$b$$ exakt (in ${:u}). Es gilt $$\\sin ${:S[:i][0]}^\\circ=${:SIN[:S[:i][0]]}$$ und $$\\sin ${:S[:i][1]}^\\circ=${:SIN[:S[:i][1]]}$$.",
            "shortq": "$$a=${:a}$$, $$\\alpha=${:S[:i][0]}^\\circ$$, $$\\beta=${:S[:i][1]}^\\circ$$: $$b=?$$",
            "answer": "$$\\dfrac{b}{\\sin\\beta}=\\dfrac{a}{\\sin\\alpha}\\iff b=\\dfrac{a\\cdot\\sin\\beta}{\\sin\\alpha}=\\dfrac{${:a}\\cdot${:SIN[:S[:i][1]]}}{${:SIN[:S[:i][0]]}}=\\color{red}{${:k==1&&:S[:i][5]>1?''::k}${:S[:i][5]>1?'\\sqrt{'+:S[:i][5]+'}':''}}$$ ${:u}",
            "value": "${:k==1&&:S[:i][5]>1?''::k}${:S[:i][5]>1?'\\sqrt{'+:S[:i][5]+'}':''}"
