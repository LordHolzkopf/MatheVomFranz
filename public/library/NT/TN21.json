{
  "ID": "TN21",
  "title": "Grenzwerte grundlegender Folgen bestimmen",
  "description": "Grenzwert, Limes, Folgen, Konvergenz, Divergenz, Nullfolge, Potenz, Wurzel, a·nᵇ, a/nᵇ, a·√n, bestimmt divergent",
  "type": "text",
  "dest":["WEB"],
 "options": [
    {
      "name": "Folgen der Form a·nᵇ",
      "vars": {
        "a": "-5_5_^0",
        "b": "1_5",
        "f": "${MMmath.box(['Multiply', :a, ['Power', 'n', :b]])}",
        "lim": "${:a > 0 ? '+\\infty' : '-\\infty'}",
        "set": "\\mathbb{N}"
      }
    },
    {
      "name": "Folgen der Form a/nᵇ",
      "vars": {
        "a": "-5_5_^0",
        "b": "1_5",
        "f": "${MMmath.box(['Divide', :a, ['Power', 'n', :b]])}",
        "lim": "0",
        "set": "\\mathbb{N}\\setminus\\{0\\}"
      }
    },
    {
      "name": "Folgen der Form a·√n",
      "vars": {
        "a": "-5_5_^0",
        "f": "${MMmath.box(['Multiply', :a, ['Sqrt', 'n']])}",
        "lim": "${:a > 0 ? '+\\infty' : '-\\infty'}",
        "set": "\\mathbb{N}"
      }
    }
  ],
  "question": "Gegeben ist die Folge mit $$a_n = ${:f}$$ für $$n \\in ${:set}$$. Bestimme den Grenzwert für $$n \\to +\\infty$$.",
  "answer": "$$\\lim\\limits_{n \\to +\\infty} a_n = \\color{red}{${:lim}}$$",
  "value": "${:lim}"
}