{
    "title":"Potenzen mit negativen Exponenten als Bruch schreiben",
    "type":"latex",
    "ID":"HPF1",
    "keys":["/"],
    "description":"Potenzen mit negativen Exponenten als Bruch schreiben: Kehrwert, a hoch minus n, Variablen, Brüche, Zehnerpotenzen",
    "dest":["9DA", "9DB"],
    "consts":{"lettres":["a","b","c","d","u","v","t","x","y","z"]},
    "consigne":"Schreibe als Bruch.",
    "options":[{
        "name":"Kehrwert einer Variablen",
        "vars":{"a":"0_9", "l":"${:lettres[:a]}"},
        "question": "${:l}^{-1}",
        "answer":":question=\\color{red}{\\dfrac{1}{${:l}}}",
        "value":"\\dfrac{1}{${:l}}"
    }, {
        "name":"Kehrwert einer gemischten Zahl",
        "vars":{
            "a":"1_9",
            "b":"1_9",
            "c":"1_9",
            "not":"${:a}\\frac{${:b}}{${:c}}",
            "inv":"\\dfrac{${:c}}{${:a*:c+:b}}"
        },
        "question":"\\left(${:not}\\right)^{-1}",
        "answer":":question=\\color{red}{${:inv}}",
        "value":"${:inv}"
    }, {
        "name":"Negativer Exponent, positive ganze Zahl als Basis",
        "vars":{"p":"-3_-2", "a":"2_${:p==-3?5:15}"},
        "question":"${:a}^{${:p}}",
        "answer":":question=\\color{red}{\\dfrac{1}{${:a**(-:p)}}}",
        "value":"\\dfrac{1}{${:a**(-:p)}}"
    }, {
        "name":"Negativer Exponent, negative ganze Zahl als Basis",
        "vars":{"p":"-3_-2", "a":"${:p==-3?-5:-15}_-2"},
        "question":"(${:a})^{${:p}}",
        "answer":":question=\\color{red}{\\dfrac{${:p==-3?-1:1}}{${(-:a)**(-:p)}}}",
        "value":["\\dfrac{${:p==-3?-1:1}}{${(-:a)**(-:p)}}", "\\dfrac{1}{${:a**(-:p)}}"]
    }, {
        "name":"Negativer Exponent, Variable als Basis",
        "vars":{"p":"-10_-2", "l":"0_9", "a":"${:lettres[:l]}"},
        "question":"${:a}^{${:p}}",
        "answer":":question=\\color{red}{\\dfrac{1}{${:a}^{${-:p}}}}",
        "value":"\\dfrac{1}{${:a}^{${-:p}}}"
    }, {
        "name":"Negativer Exponent, Bruch als Basis",
        "vars":{"p":"-3_-2", "a":"2_${:p==-3?5:15}", "b":"2_${:p==-3?5:15}"},
        "question":"\\left(\\dfrac{${:a}}{${:b}}\\right)^{${:p}}",
        "answer":":question=\\color{red}{\\dfrac{${:b**(-:p)}}{${:a**(-:p)}}}",
        "value":"\\dfrac{${:b**(-:p)}}{${:a**(-:p)}}"
    }, {
        "name":"Negativer Exponent, Dezimalzahl 0,1; 0,01; … als Basis",
        "vars":{"d":"-6_-1", "p":"-6_-1"},
        "question":"${MMmath.round(10**:d,8)}^{${:p}}",
        "answer":":question=\\color{green}{10^{${:d}\\times(${:p})}}=\\color{red}{${10**(:d*:p)}}",
        "value":["${10**(:d*:p)}","10^{${:d*:p}}"]
    }
    ]
}
