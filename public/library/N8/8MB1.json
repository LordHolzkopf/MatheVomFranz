{
    "ID":"8MB1",
    "title":"Flächeninhalt und Umfang durch Kästchenzählen",
    "description":"Flächeninhalt, Umfang, Kästchen zählen, Karopapier, Einheitsquadrat, Quadrat, Rechteck, cm, cm²",
    "dest":["5DB", "5DC"],
    "keys":["_","_","cm","x²","_","_","_","_"],
    "type":"text",
    "options":[
        {
            "name":"Flächeninhalt und Umfang des Quadrats",
            "vars":{
                "c1":"2_6",
                "c2":"${:c1}",
                "fig":"Quadrats",
                "w":"${3+Math.floor((9-:c1)/2)}",
                "h":"${1+Math.floor((6-:c2)/2)}"
            }
        },{
            "name":"Flächeninhalt und Umfang des Rechtecks",
            "vars":{
                "c1":"2_9",
                "c2":"1_6_^${:c1}",
                "fig":"Rechtecks",
                "w":"${3+Math.floor((9-:c1)/2)}",
                "h":"${1+Math.floor((6-:c2)/2)}"
            }
        }
    ],
    "figure":{
        "type":"graph",
        "axis":false,
        "boundingbox":[0,8,13,0],
        "content":[
            ["grid", [],{}],
            ["point", [1, 2], {"name":"A","face":"", "label":{"visible":false}}],
            ["point", [2, 2], {"name":"B","face":"", "label":{"visible":false}}],
            ["segment", ["A","B"]],
            ["text", [0.7, 1.2, "1 cm"], {"fontSize":8}],
            ["point", [1, 5], {"name":"C","face":"", "label":{"visible":false}}],
            ["point", [2, 5], {"name":"D","face":"", "label":{"visible":false}}],
            ["point", [2, 6], {"name":"E","face":"", "label":{"visible":false}}],
            ["point", [1, 6], {"name":"F","face":"", "label":{"visible":false}}],
            ["polygon", ["C","D","E","F"], {"fillColor":"green"}],
            ["text", [0.7, 4.2, "1 cm²"], {"fontSize":8}],
            ["point", ["${:w}", "${:h}"], {"name":"G","face":"", "label":{"visible":false}}],
            ["point", ["${:w}", "${:h+:c2}"], {"name":"H","face":"", "label":{"visible":false}}],
            ["point", ["${:w+:c1}", "${:h+:c2}"], {"name":"I","face":"", "label":{"visible":false}}],
            ["point", ["${:w+:c1}", "${:h}"], {"name":"J","face":"", "label":{"visible":false}}],
            ["polygon", ["G","H","I","J"], {"fillColor":"none"}]
        ]
    },
    "question":[
        "Wie groß ist der Umfang des ${:fig}?",
        "Wie groß ist der Flächeninhalt des ${:fig}?",
        "Wie groß sind Umfang und Flächeninhalt des ${:fig}?"
    ],
    "answer":[
        "$$${:c1*2 + :c2*2} \\text{ cm}$$",
        "$$${:c1*:c2} \\text{ cm}^2$$",
        "Umfang: $$${:c1*2 + :c2*2} \\text{ cm}$$, Flächeninhalt: $$${:c1*:c2} \\text{ cm}^2$$"
    ],
    "value":[
        "${:c1*2 + :c2*2}\\text{ cm}",
        "${:c1*:c2}\\text{ cm}^2",
        "${:c1*2 + :c2*2}\\text{ cm}$$ und $$${:c1*:c2}\\text{ cm}^2"
    ]
}
