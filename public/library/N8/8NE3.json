{
    "title":"Dezimalzahlen durch 10, 100, 1000 dividieren",
    "description":"Kommaverschiebung, zufällige Dezimalzahlen oder Dezimalzahlen mit bis zu 3 Ziffern durch 10, 100, 1000 dividieren, Komma nach links verschieben",
    "ID":"8NE3",
    "speech":1,
    "params":{"fige":{"label":"Gleiche gültige Ziffern beibehalten","defaut":false,"fige":["m", "decs"]}},
    "dest":["6ED"],
    "keys":"numerique",
    "vars":{"a":[1,9,99,999,9999], "b":"1_3","decs":"","p":"", "c0":"d0_${:a}_${:b}_^0", "m":"1_999", "q":"-3_1", "c":"${:fige ? MMmath.round(:m*Math.pow(10,:q),4) : :c0}"},
    "options":[{
        "name":"Dezimalzahl durch 10",
        "question": "${:c}\\div 10",
        "audio": "${String(:c).replace('.',',')} geteilt durch 10",
