        "value":"${MMmath.calc((:choix?:nb+'*'+:nb::n1+'*'+:nb)+:opes[:op1]+(:choix?(:m1+2)+'*'+:nb::nb+'*'+:nb)+(:choix2?:opes[:op2]+:n2:''))}"
    }]
