{
    "title":"Gleichungen der Form x ± a = b lösen",
    "description":"Gleichung lösen, lineare Gleichung, Variable, Lösung, Äquivalenzumformung",
    "type":"latex",
    "ID":"4NE6",
    "textSize":"medium",
    "dest":["7DD"],
    "keys":["_","_","/","-","_","_","_","_"],
    "consts":{"lettres":["u","v","t","x", "y", "z"]},
    "options":[{
        "name":"x ± a = b, ganze Zahlen",
        "vars":{"a":"1_99","b":"-99_99", "l":"0_5","x":"${:lettres[:l]}"},
        "question": ["\\text{Löse } ${:x}+${:a}=${:b}","\\text{Löse } ${:x}-${:a}=${:b}"],
        "answer":["${:x}+${:a}=${:b} \\text{ gilt für } \\color{red}{${:x}=${:b-:a}}"," ${:x}-${:a}=${:b} \\text{ gilt für } \\color{red}{${:x}=${:b+:a}}"],
        "value":["${:b-:a}","${:b+:a}"]
    },{
        "name":"x ± a = b, Dezimalzahlen",
        "vars":{"a":"d0.1_10_1","b":"d-10_10_1", "l":"0_5","x":"${:lettres[:l]}"},
        "question": ["\\text{Löse } ${:x}+${:a}=${:b}","\\text{Löse } ${:x}-${:a}=${:b}"],
        "answer":["${:x}+${:a}=${:b} \\text{ gilt für } \\color{red}{${:x}=${MMmath.round(:b-:a,1)}}","${:x}-${:a}=${:b} \\text{ gilt für } \\color{red}{${:x}=${MMmath.round(:b+:a,1)}}"],
        "value":["${MMmath.round(:b-:a,1)}","${MMmath.round(:b+:a,1)}"]
    },{
        "name":"x ± a = b, Brüche",
        "vars":{"n":"1_12_2","d":"2_12_2", "l":"0_5","x":"${:lettres[:l]}"},
        "question":[
            "\\text{Löse } ${:x}+${MMmath.fractionSimplifiee(:n[0],:d[0])}=${MMmath.fractionSimplifiee(:n[1],:d[1])}",
            "\\text{Löse } ${:x}-${MMmath.fractionSimplifiee(:n[0],:d[0])}=${MMmath.fractionSimplifiee(:n[1],:d[1])}"],
        "answer":[
            "${:x}+${MMmath.fractionSimplifiee(:n[0],:d[0])}=${MMmath.fractionSimplifiee(:n[1],:d[1])} \\text{ gilt für } \\color{red}{${:x}=${MMmath.calc(:n[1]+'/'+:d[1]+'-'+:n[0]+'/'+:d[0])}}",
            "${:x}-${MMmath.fractionSimplifiee(:n[0],:d[0])}=${MMmath.fractionSimplifiee(:n[1],:d[1])} \\text{ gilt für } \\color{red}{${:x}=${MMmath.calc(:n[1]+'/'+:d[1]+'+'+:n[0]+'/'+:d[0])}}"],
        "value":["${MMmath.calc(:n[1]+'/'+:d[1]+'-'+:n[0]+'/'+:d[0])}","${MMmath.calc(:n[1]+'/'+:d[1]+'+'+:n[0]+'/'+:d[0])}"]
    }]
}