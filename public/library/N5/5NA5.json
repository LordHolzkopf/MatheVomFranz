{
    "title":"Einfache Brüche in Prozent umwandeln",
    "ID":"5NA5",
    "description":"Bruch in Prozent umwandeln, Prozentsatz, Anteil in Prozent, Hundertstel, einfache Brüche wie 1/2, 1/4, 3/5",
    "speech":1,
    "keys":["/"],
    "textSize":"medium",
    "dest":["5FD", "6AD", "6BC"],
    "options":[{
        "name":"Stammbrüche (Zähler 1)",
        "vars":{"den":[2,3,4,5,10,20,25,50,100], "num":"1"},
        "value":["${MMmath.round(:num/:den,2)*100}%","${MMmath.round(:num/:den,2)*100}"]
    },{
        "name":"Brüche mit Zähler größer als 1",
        "vars":{"den":[2,3,4,5,10,20,25,50,100,200,300,400,500],"m":"2_10", "num":"${:den>100?(:den*:m/100):'2_'+:den}"},
        "value":["${MMmath.round(:num/:den,2)*100}%","${MMmath.round(:num/:den,2)*100}"]
    },{
        "name":"Unechte Brüche (größer als 1)",
        "vars":{"den":[2,3,4,5,10,20,25,50,100], "num":"${:den+1}_${:den*2}"},
        "value":["${MMmath.round(:num/:den,2)*100}%","${MMmath.round(:num/:den,2)*100}"]
    }],
    "question":"\\text{Wie viel Prozent sind } \\dfrac{${:num}}{${:den}}\\text{?}",
    "audio":"Wie viel Prozent sind ${MMmath.bruchwort(:num,:den)}?",
    "answer":"\\dfrac{${:num}}{${:den}}${MMmath.round(:num/:den,2)!=MMmath.round(:num/:den,3)?'\\approx':'='}\\color{red}{${MMmath.round(:num/:den*100)}\\%}"
}