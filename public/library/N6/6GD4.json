{
    "ID": "6GD4",
    "title": "Umkreis eines Dreiecks erkennen",
    "description": "Umkreis eines Dreiecks erkennen: Kreis durch alle Eckpunkte, Mittelpunkt, Radius, Durchmesser, gleich lange Strecken angeben",
    "type":"text",
    "dest":["8FB", "6DC"],
    "consts":{"lettres":"ABCDEFGHJKLMNPQRSTUVW"},
    "options":[
        {
            "name": "Umkreis",
            "vars":{
                "l":"0_${:lettres.length-1}_3_^&",
                "a1":"-9_9",
                "ang1":"${:a1*10}",
                "R":3.5,
                "xA":"${Math.cos(Math.PI/180*(:ang1))*:R}",
                "yA":"${Math.sin(Math.PI/180*(:ang1))*:R}",
                "a2":"6_12",
                "ang2":"${(:a1+:a2)*10}",
                "xB":"${Math.cos(Math.PI/180*(:ang2))*:R}",
                "yB":"${Math.sin(Math.PI/180*(:ang2))*:R}",
                "a3":"6_12_^${18-:a2}",
                "ang3":"${(:a1+:a2+:a3)*10}",
                "xC":"${Math.cos(Math.PI/180*(:ang3))*:R}",
                "yC":"${Math.sin(Math.PI/180*(:ang3))*:R}",
                "A":"${:lettres[:l[0]]}",
                "B":"${:lettres[:l[1]]}",
                "C":"${:lettres[:l[2]]}",
                "egalites":"O${:A}=O${:B}=O${:C}",
                "rep":"Ja"
            },
            "figure":{
                "type": "graph",
                "axis":false,
                "boundingbox":[-8,-6,8,6],
                "content":[
                    ["point",[0,0],{"name":"O", "face":"x", "label":{"offset":[5,8]}}],
                    ["circle",["O","${:R}"], {"strokeWidth":1.3}],
                    ["point",["${:xA}","${:yA}"],{"name":"${:A}","face":"x", "label":{"offset":["${Math.cos(:ang1*Math.PI/180)*12-3}","${-Math.sin(:ang1*Math.PI/180)*12}"]}}],
                    ["point",["${:xB}","${:yB}"],{"name":"${:B}","face":"x", "label":{"offset":["${Math.cos(:ang2*Math.PI/180)*12-3}","${-Math.sin(:ang2*Math.PI/180)*12}"]}}],
                    ["point",["${:xC}","${:yC}"],{"name":"${:C}","face":"x", "label":{"offset":["${Math.cos(:ang3*Math.PI/180)*12-3}","${-Math.sin(:ang3*Math.PI/180)*12}"]}}],
                    ["polygon",["${:A}", "${:B}", "${:C}"]]
                ]
            }
        },{
            "name": "Kreis durch zwei Eckpunkte",
            "vars":{
                "l":"0_${:lettres.length-1}_3_^&",
                "a1":"-9_9",
                "ang1":"${:a1*10}",
                "R":3.5,
                "xA":"${Math.cos(Math.PI/180*(:ang1))*:R}",
                "yA":"${Math.sin(Math.PI/180*(:ang1))*:R}",
                "a2":"6_12",
                "ang2":"${(:a1+:a2)*10}",
                "delta":[-1.2,1.5],
                "xB":"${Math.cos(Math.PI/180*(:ang2))*(:R+:delta)}",
                "yB":"${Math.sin(Math.PI/180*(:ang2))*(:R+:delta)}",
                "a3":"6_12_^${18-:a2}",
                "ang3":"${(:a1+:a2+:a3)*10}",
                "xC":"${Math.cos(Math.PI/180*(:ang3))*:R}",
                "yC":"${Math.sin(Math.PI/180*(:ang3))*:R}",
                "A":"${:lettres[:l[0]]}",
                "B":"${:lettres[:l[1]]}",
                "C":"${:lettres[:l[2]]}",
                "egalites":"O${:A}=O${:C}",
                "rep":"Nein"
            },
            "figure":{
                "type": "graph",
                "axis":false,
                "boundingbox":[-8,-6,8,6],
                "content":[
                    ["point",[0,0],{"name":"O", "face":"x", "label":{"offset":[5,8]}}],
                    ["circle",["O","${:R}"], {"strokeWidth":1.3}],
                    ["point",["${:xA}","${:yA}"],{"name":"${:A}","face":"x", "label":{"offset":["${Math.cos(:ang1*Math.PI/180)*12-3}","${-Math.sin(:ang1*Math.PI/180)*12}"]}}],
                    ["point",["${:xB}","${:yB}"],{"name":"${:B}","face":"x", "label":{"offset":["${Math.cos(:ang2*Math.PI/180)*12-3}","${-Math.sin(:ang2*Math.PI/180)*12}"]}}],
                    ["point",["${:xC}","${:yC}"],{"name":"${:C}","face":"x", "label":{"offset":["${Math.cos(:ang3*Math.PI/180)*12-3}","${-Math.sin(:ang3*Math.PI/180)*12}"]}}],
                    ["polygon",["${:A}", "${:B}", "${:C}"]]
                ]
            }
        },{
            "name": "Kreis durch einen Eckpunkt",
            "vars":{
                "l":"0_${:lettres.length-1}_3_^&",
                "a1":"-9_9",
                "ang1":"${:a1*10}",
                "R":3.5,
                "xA":"${Math.cos(Math.PI/180*(:ang1))*:R}",
                "yA":"${Math.sin(Math.PI/180*(:ang1))*:R}",
                "a2":"6_12",
                "ang2":"${(:a1+:a2)*10}",
                "d1":[-1.2,1.5],
                "xB":"${Math.cos(Math.PI/180*(:ang2))*(:R+:d1)}",
                "yB":"${Math.sin(Math.PI/180*(:ang2))*(:R+:d1)}",
                "a3":"6_12",
                "ang3":"${(:a1+:a2+:a3)*10}",
                "d2":[-1.2,1.5],
                "xC":"${Math.cos(Math.PI/180*(:ang3))*(:R+:d2)}",
                "yC":"${Math.sin(Math.PI/180*(:ang3))*(:R+:d2)}",
                "A":"${:lettres[:l[0]]}",
                "B":"${:lettres[:l[1]]}",
                "C":"${:lettres[:l[2]]}",
                "egalites":"",
                "rep":"Nein"
            },
            "figure":{
                "type": "graph",
                "axis":false,
                "boundingbox":[-8,-6,8,6],
                "content":[
                    ["point",[0,0],{"name":"O", "face":"x", "label":{"offset":[5,8]}}],
                    ["circle",["O","${:R}"], {"strokeWidth":1.3}],
                    ["point",["${:xA}","${:yA}"],{"name":"${:A}","face":"x", "label":{"offset":["${Math.cos(:ang1*Math.PI/180)*12-3}","${-Math.sin(:ang1*Math.PI/180)*12}"]}}],
                    ["point",["${:xB}","${:yB}"],{"name":"${:B}","face":"x", "label":{"offset":["${Math.cos(:ang2*Math.PI/180)*12-3}","${-Math.sin(:ang2*Math.PI/180)*12}"]}}],
                    ["point",["${:xC}","${:yC}"],{"name":"${:C}","face":"x", "label":{"offset":["${Math.cos(:ang3*Math.PI/180)*12-3}","${-Math.sin(:ang3*Math.PI/180)*12}"]}}],
                    ["polygon",["${:A}", "${:B}", "${:C}"]]
                ]
            }
        },{
            "name": "Kreis mit einer Seite als Durchmesser",
            "vars":{
                "l":"0_${:lettres.length-1}_3_^&",
                "a1":"-9_9",
                "ang1":"${:a1*10}",
                "R":3.5,
                "xA":"${Math.cos(Math.PI/180*(:ang1))*:R}",
                "yA":"${Math.sin(Math.PI/180*(:ang1))*:R}",
                "a2":"6_12",
                "ang2":"${(:a1+:a2)*10}",
                "d1":[-1.2,0,1.5,"A"],
                "xB":"${:d1!='A'?Math.cos(Math.PI/180*(:ang2))*(:R+:d1)::xA+Math.cos((:ang1+90)*Math.PI/180)*3}",
                "yB":"${:d1!='A'?Math.sin(Math.PI/180*(:ang2))*(:R+:d1)::yA+Math.sin((:ang1+90)*Math.PI/180)*3}",
                "a3":"${18-:a2}",
                "ang3":"${(:a1+:a2+:a3)*10}",
                "xC":"${Math.cos(Math.PI/180*(:ang3))*:R}",
                "yC":"${Math.sin(Math.PI/180*(:ang3))*:R}",
                "A":"${:lettres[:l[0]]}",
                "B":"${:lettres[:l[1]]}",
                "C":"${:lettres[:l[2]]}",
                "egalites":"O${:A}=O${:C}${:d1==0?'=O'+:B:''}",
                "rep":"${:d1==0?'Ja':'Nein'}"
            },
            "figure":{
                "type": "graph",
                "axis":false,
                "boundingbox":[-8,-6,8,6],
                "content":[
                    ["point",[0,0],{"name":"O", "face":"x", "label":{"offset":[5,8]}}],
                    ["circle",["O","${:R}"], {"strokeWidth":1.3}],
                    ["point",["${:xA}","${:yA}"],{"name":"${:A}","face":"x", "label":{"offset":["${Math.cos(:ang1*Math.PI/180)*12-3}","${-Math.sin(:ang1*Math.PI/180)*12}"]}}],
                    ["point",["${:xB}","${:yB}"],{"name":"${:B}","face":"x", "label":{"offset":["${Math.cos(:ang2*Math.PI/180)*12-3}","${-Math.sin(:ang2*Math.PI/180)*12}"]}}],
                    ["point",["${:xC}","${:yC}"],{"name":"${:C}","face":"x", "label":{"offset":["${Math.cos(:ang3*Math.PI/180)*12-3}","${-Math.sin(:ang3*Math.PI/180)*12}"]}}],
                    ["polygon",["${:A}", "${:B}", "${:C}"]],
                    ["angle",["${:d1=='A'?:B::C}","${:d1=='A'?:A::B}","${:d1=='A'?:C::A}"], {"radius":1,"label":{"visible":false}}]
                ]
            }
        }
    ],
    "question":"Ist der Kreis um O der Umkreis des Dreiecks ${:A+:B+:C}?<br>Gib alle gleich langen Strecken zwischen den Punkten O, ${:A}, ${:B} und ${:C} an.",
    "answer":"<span class='red'>${:rep}</span><br>$$${:egalites}$$",
    "value":"${:egalites}"
}