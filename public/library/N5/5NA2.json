{
    "title":"Gegenzahl angeben",
    "type":"text",
    "ID":"5NA2",
    "textSize":"medium",
    "keys":["/"],
    "description":"Gegenzahl einer Zahl angeben, positive und negative Zahlen, ganze Zahlen, Dezimalzahlen, Brüche, Vorzeichen. Online-Modus: Bei Brüchen Zähler und Nenner positiv lassen und das Minuszeichen vor den negativen Bruch setzen.",
    "dest":["7AA", "6GD"],
    "options":[{
        "name":"Gegenzahl einer ganzen Zahl",
        "vars":{"a":"-100_100", "opp":"${-:a}"}
    },{
        "name":"Gegenzahl einer Dezimalzahl",
        "vars":{"a":"d-100_100_2", "opp":"${-:a}"}
    },{
        "name":"Gegenzahl eines Bruchs",
        "vars":{"n":"-50_50","d":"-50_50_^${:n},1,0", "frac":"${MMmath.fractionSimplifiee(:n,:d)}","fracpos":"${MMmath.fractionSimplifiee(Math.abs(:n),Math.abs(:d))}", "opp":""},
        "question":["Wie heißt die Gegenzahl von $$${:frac}$$?","$$-\\left(${:frac}\\right)$$"],
        "answer":["Die Gegenzahl von $$${:frac}$$ ist $$\\color{red}{${:n*:d<0?'':'-'}${:fracpos}}$$",
        "$$-\\left(${:frac}\\right)=\\color{red}{${:n*:d<0?'':'-'}${:fracpos}}$$"],
        "value":"${:n*:d<0?'':'-'}${:fracpos}"
    }],
    "question":["Wie heißt die Gegenzahl von $$${:a}$$?", "$$-(${:a})=?$$"],
    "answer":["Die Gegenzahl von $$${:a}$$ ist $$\\color{red}{${:opp}}$$", "$$-(${:a})=\\color{red}{${:opp}}$$"],
    "value":"${:opp}"
}